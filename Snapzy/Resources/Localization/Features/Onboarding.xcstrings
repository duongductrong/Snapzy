            "state": "translated",
            "value": "Grabación en curso (%ds)... Pulsa Detener o espera 3s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement en cours (%ds)... Appuyez sur Arrêter ou attendez 3 s."
          }
