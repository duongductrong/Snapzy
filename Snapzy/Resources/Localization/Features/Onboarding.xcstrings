  "strings": {
    "onboarding.action.close-hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einführung schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close onboarding"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar bienvenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer l’intégration"
          }
