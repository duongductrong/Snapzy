          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在任何应用程序中监听 ⇧⌘4 和您的自定义全局快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
