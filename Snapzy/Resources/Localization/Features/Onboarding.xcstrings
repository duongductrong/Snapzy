    "onboarding.step.recording.prompt-active": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme läuft (%ds)... Tippen Sie auf Stopp oder warten Sie 3s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
