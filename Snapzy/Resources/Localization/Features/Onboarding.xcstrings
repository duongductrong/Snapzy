    "onboarding.permissions.accessibility-promise": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagiert in jeder App auf ⇧⌘4 und Ihre benutzerdefinierten Tastenkombinationen"
          }
        },
        "en": {
