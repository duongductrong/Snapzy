            "value": "Añade uno desde Descubrir para ampliar Snapzy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en une depuis Découvrir pour enrichir Snapzy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「見つける」から追加すると Snapzy に機能が増えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘둘러보기’에서 하나를 추가해 Snapzy에 도구를 더해 보세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте плагин из каталога, чтобы расширить Snapzy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một tiện ích từ mục Khám phá để Snapzy có thêm công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从「发现」中添加一个，为 Snapzy 增加更多工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從「探索」中新增一個，為 Snapzy 增加更多工具。"
          }
        }
      }
    },
