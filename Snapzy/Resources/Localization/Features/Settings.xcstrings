    "preferences-plugins.remove-alert-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit werden das Plugin, seine Einstellungen und alles Gespeicherte gelöscht — auch hinterlegte Passwörter. Das lässt sich nicht rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes the plugin along with its settings and anything it saved, including passwords it stored. You can't undo this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra el plugin junto con sus ajustes y todo lo que haya guardado, incluidas las contraseñas. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime l'extension, ses réglages et tout ce qu'elle a enregistré, y compris les mots de passe. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインと設定、保存された内容（パスワードを含む）をすべて削除します。取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인과 설정, 저장된 항목(암호 포함)을 모두 삭제합니다. 되돌릴 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагин будет удалён вместе с настройками и всем, что он сохранил, включая пароли. Отменить нельзя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa tiện ích cùng cài đặt và mọi thứ nó đã lưu, kể cả mật khẩu. Bạn không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除插件及其设置和保存的所有内容，包括存储的密码。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會刪除外掛程式及其設定和儲存的所有內容，包括已儲存的密碼。此操作無法復原。"
          }
        }
      }
    },
