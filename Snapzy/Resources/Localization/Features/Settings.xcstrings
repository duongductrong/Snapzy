    "preferences-plugins.reset-permissions-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergisst deine Zustimmungen, damit Snapzy beim nächsten Start wieder fragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget what you allowed, so Snapzy asks the next time this plugin runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida lo que permitiste para que Snapzy vuelva a preguntar la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oublie vos autorisations pour que Snapzy vous redemande la prochaine fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可した内容を忘れ、次回の実行時に再び確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용한 내용을 잊고, 다음에 실행할 때 다시 물어봅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Забыть выданные разрешения, чтобы Snapzy спросил снова при следующем запуске."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quên những gì bạn đã cho phép, để Snapzy hỏi lại vào lần chạy tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忘记你已允许的内容，下次运行时 Snapzy 会重新询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
