    "preferences-plugins.development-note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus einem Ordner geladene Plugins laden sich nach jedem Build neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins loaded from a folder reload themselves whenever you rebuild them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins cargados desde una carpeta se recargan solos cada vez que los compilas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extensions chargées depuis un dossier se rechargent à chaque compilation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダから読み込んだプラグインは、再ビルドのたびに自動で再読み込みされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더에서 불러온 플러그인은 다시 빌드할 때마다 자동으로 새로 불러옵니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагины, загруженные из папки, перезагружаются при каждой пересборке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích tải từ thư mục sẽ tự nạp lại mỗi khi bạn build lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从文件夹载入的插件会在你重新构建时自动重载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從資料夾載入的外掛程式會在你重新建置時自動重新載入。"
          }
        }
      }
    },
