    "preferences-plugins.activity-log-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, worum Plugins Snapzy gebeten haben. Passwörter und andere Geheimnisse werden entfernt — du kannst es gefahrlos in einen Fehlerbericht einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything plugins asked Snapzy to do. Passwords and other secrets are stripped out, so it's safe to paste into a bug report."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que los plugins pidieron a Snapzy. Las contraseñas y otros secretos se eliminan, así que puedes pegarlo en un informe de error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que les extensions ont demandé à Snapzy. Les mots de passe et autres secrets sont retirés : vous pouvez le coller dans un rapport de bug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインが Snapzy に要求した内容の一覧です。パスワードなどの秘密情報は取り除かれているため、不具合報告に貼り付けても安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인이 Snapzy에 요청한 모든 내용입니다. 암호 등 비밀 정보는 제거되므로 버그 리포트에 붙여 넣어도 안전합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, о чём плагины просили Snapzy. Пароли и другие секреты удалены, поэтому запись можно вставить в отчёт об ошибке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi yêu cầu tiện ích gửi cho Snapzy. Mật khẩu và thông tin bí mật đã được lược bỏ nên bạn có thể dán vào báo cáo lỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件向 Snapzy 发出的所有请求。密码等机密信息已被移除，可安全粘贴到问题报告中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛程式向 Snapzy 發出的所有請求。密碼等機密資訊已被移除，可安全貼到問題回報中。"
          }
        }
      }
    },
    "preferences-plugins.activity-log-empty": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts. Führe einen Plugin-Befehl aus, dann erscheinen seine Anfragen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. Run a plugin command and its requests show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay nada. Ejecuta un comando de plugin y sus peticiones aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l'instant. Lancez une commande d'extension et ses requêtes apparaîtront ici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ何もありません。プラグインのコマンドを実行すると、その要求がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없습니다. 플러그인 명령을 실행하면 요청이 여기에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока пусто. Запустите команду плагина — его запросы появятся здесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì. Chạy một lệnh của tiện ích và các yêu cầu sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有内容。运行一个插件命令，其请求就会出现在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前沒有內容。執行一個外掛程式指令，其請求就會出現在這裡。"
          }
        }
      }
    },
