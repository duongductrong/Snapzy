    "preferences-plugins.sandbox-note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Plugin ist auf die gleiche Weise vom Rest deines Macs abgeschottet — unabhängig davon, wer es gemacht hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every plugin is locked away from the rest of your Mac in the same way, whoever made it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los plugins quedan aislados del resto del Mac de la misma forma, sea quien sea su autor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque extension est isolée du reste de votre Mac de la même manière, quel qu'en soit l'auteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作者が誰であっても、すべてのプラグインは同じように Mac の他の部分から隔離されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 만들었든 모든 플러그인은 동일한 방식으로 Mac의 나머지 부분과 격리됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой плагин, кем бы он ни был создан, одинаково изолирован от остальной системы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tiện ích đều bị tách biệt khỏi phần còn lại của máy Mac theo cùng một cách, bất kể ai tạo ra nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论出自谁手，每个插件都以相同方式与 Mac 的其余部分隔离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論出自誰手，每個外掛程式都以相同方式與 Mac 的其餘部分隔離。"
          }
        }
      }
    },
