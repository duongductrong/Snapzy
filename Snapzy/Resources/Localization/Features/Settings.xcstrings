    "preferences-plugins.intro": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins erweitern Snapzy um zusätzliche Werkzeuge. Jedes läuft abgeschottet vom Rest deines Macs und muss fragen, bevor es deine Aufnahme lesen, das Internet nutzen oder etwas ändern darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plugins add extra tools to Snapzy. Each one runs locked away from the rest of your Mac and has to ask before it can read your capture, use the internet, or change anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los plugins añaden herramientas adicionales a Snapzy. Cada uno se ejecuta aislado del resto del Mac y debe pedirte permiso antes de leer tu captura, usar internet o cambiar algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les extensions ajoutent des outils à Snapzy. Chacune s'exécute isolée du reste de votre Mac et doit demander votre accord avant de lire votre capture, d'utiliser internet ou de modifier quoi que ce soit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プラグインは Snapzy に機能を追加します。それぞれ Mac の他の部分から隔離して動作し、キャプチャの読み取り・インターネットの利用・変更の前に必ず確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플러그인은 Snapzy에 추가 도구를 더합니다. 각 플러그인은 Mac의 나머지 부분과 격리되어 실행되며, 캡처를 읽거나 인터넷을 사용하거나 무언가를 바꾸기 전에 반드시 물어봅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плагины добавляют в Snapzy дополнительные инструменты. Каждый работает изолированно от остальной системы и обязан спросить разрешение, прежде чем прочитать снимок, выйти в интернет или что-то изменить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiện ích mở rộng bổ sung công cụ cho Snapzy. Mỗi tiện ích chạy tách biệt khỏi phần còn lại của máy Mac và phải xin phép trước khi đọc ảnh chụp, dùng internet hay thay đổi bất cứ thứ gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插件为 Snapzy 添加额外工具。每个插件都与 Mac 的其余部分隔离运行，读取你的截图、联网或做出更改前都必须征得同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外掛程式為 Snapzy 增加額外工具。每個外掛程式都與 Mac 的其餘部分隔離執行，讀取你的擷取內容、連線或變更任何東西前都必須先徵求同意。"
          }
        }
      }
    },
