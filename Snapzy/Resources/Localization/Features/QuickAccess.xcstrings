    "preferences-quick-access.swipe-toward-edge-collapses-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Vorschau am Bildschirmrand einklappen, statt die Wischaktion dieser Seite auszuführen. Zum Zurückholen auf den Streifen klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuck the preview into the screen edge instead of running the swipe action for that side. Click the strip to bring it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda la vista previa en el borde de la pantalla en lugar de ejecutar la acción de deslizar de ese lado. Haz clic en la franja para recuperarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Range l’aperçu sur le bord de l’écran au lieu d’exécuter l’action de balayage de ce côté. Cliquez sur la bande pour le récupérer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מכווץ את התצוגה המקדימה לקצה המסך במקום להפעיל את פעולת ההחלקה של אותו צד. לחצו על הפס כדי להחזיר אותה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その方向のスワイプ操作を実行する代わりに、プレビューを画面端にしまいます。帯をクリックすると元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 방향의 스와이프 동작을 실행하는 대신 미리보기를 화면 가장자리로 접습니다. 띠를 클릭하면 다시 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убирает превью к краю экрана вместо действия смахивания для этой стороны. Нажмите на полоску, чтобы вернуть его."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thu bản xem trước vào cạnh màn hình thay vì chạy thao tác vuốt của phía đó. Nhấn vào dải ở cạnh để đưa nó trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将预览收起到屏幕边缘，而不是执行该方向的轻扫操作。点按边缘的条带即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將預覽收合到螢幕邊緣，而不是執行該方向的滑動動作。按一下邊緣的條帶即可還原。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
