    "preferences-quick-access.swipe-sensitivity-description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passen Sie an, wie schnell die Karte Ihrer Trackpad-Wischbewegung folgt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust how fast the card follows your trackpad swipe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta qué tan rápido la tarjeta sigue tu gesto en el trackpad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez la vitesse de suivi de la carte lors du balayage sur le trackpad"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קביעת מהירות התגובה של הכרטיס להחלקה במשטח המגע"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラックパッドのスワイプにカードが追従する速度を調整"
          }
