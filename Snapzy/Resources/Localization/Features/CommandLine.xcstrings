          }
        }
      }
    },
    "command-line.prompt-unverified": {
      "comment": "Extra line in the snapzy permission alert when the app's signature cannot be verified; %@ is its path",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy konnte nicht prüfen, wer diese App erstellt hat. Erlaube es nur, wenn du der App unter %@ vertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy couldn’t verify who made this app. Only allow it if you trust the app at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy no pudo verificar quién creó esta app. Permítelo solo si confías en la app de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy n’a pas pu vérifier qui a créé cette app. Autorisez-la seulement si vous faites confiance à l’app située dans %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy はこのアプリの開発元を確認できませんでした。%@ にあるアプリを信頼できる場合のみ許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy가 이 앱의 개발자를 확인할 수 없습니다. %@에 있는 앱을 신뢰하는 경우에만 허용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy не удалось проверить разработчика этого приложения. Разрешайте, только если доверяете приложению в %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy không xác minh được nhà phát triển của ứng dụng này. Chỉ cho phép nếu bạn tin ứng dụng tại %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 无法验证此应用的开发者。仅在你信任位于 %@ 的应用时才允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 無法驗證此 App 的開發者。僅在你信任位於 %@ 的 App 時才允許。"
          }
        }
      }
    },
