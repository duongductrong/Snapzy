    "command-line.install-explanation": {
      "comment": "Popover text explaining what installing the snapzy command does; keep snapzy verbatim",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei der Installation wird snapzy zu deinem PATH hinzugefügt, damit du es in jedem Terminal oder KI-Agenten eingeben kannst. Snapzy funktioniert auch ohne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installing adds snapzy to your PATH so you can type it in any Terminal or AI agent. Snapzy keeps working without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al instalarlo, snapzy se añade a tu PATH para que puedas escribirlo en cualquier Terminal o agente de IA. Snapzy funciona igual sin él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation ajoute snapzy à votre PATH pour pouvoir le taper dans n’importe quel Terminal ou agent IA. Snapzy fonctionne aussi sans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールすると snapzy が PATH に追加され、どのターミナルや AI エージェントからでも入力できます。インストールしなくても Snapzy は動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치하면 snapzy가 PATH에 추가되어 어떤 터미널이나 AI 에이전트에서도 입력할 수 있습니다. 설치하지 않아도 Snapzy는 작동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установка добавляет snapzy в PATH, чтобы его можно было вызывать из любого Терминала или ИИ-агента. Snapzy работает и без неё."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt sẽ thêm snapzy vào PATH để bạn gõ được lệnh trong mọi Terminal hoặc AI agent. Snapzy vẫn hoạt động khi chưa cài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装后会将 snapzy 添加到 PATH，可在任意终端或 AI 代理中直接输入。不安装 Snapzy 也能正常使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝後會將 snapzy 加入 PATH，可在任何終端機或 AI 代理中直接輸入。不安裝 Snapzy 也能正常使用。"
          }
        }
      }
    },
