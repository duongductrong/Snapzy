          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”이(가) Snapzy로 화면을 캡처하려고 합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» хочет снять ваш экран через Snapzy"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” muốn chụp màn hình của bạn bằng Snapzy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”想通过 Snapzy 截取你的屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
