          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez les apps et agents IA capturer avec la commande snapzy et choisissez qui peut l’utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリや AI エージェントが snapzy コマンドでキャプチャできるようにし、使用できる相手を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 AI 에이전트가 snapzy 명령으로 캡처하도록 허용하고 사용할 수 있는 대상을 선택합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите приложениям и ИИ-агентам делать снимки командой snapzy и выберите, кому это можно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng và AI agent chụp bằng lệnh snapzy, và chọn ai được phép dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许应用和 AI 代理使用 snapzy 命令截图，并选择谁可以使用。"
