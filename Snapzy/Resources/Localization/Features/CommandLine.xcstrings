{
  "sourceLanguage": "en",
  "strings": {
    "command-line.access-description": {
      "comment": "Settings row description for the snapzy command toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps und KI-Agenten erlauben, mit dem Befehl snapzy aufzunehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let apps and AI agents capture with the snapzy command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que apps y agentes de IA capturen con el comando snapzy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permettre aux apps et aux agents IA de capturer avec la commande snapzy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリや AI エージェントが snapzy コマンドでキャプチャできるようにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱과 AI 에이전트가 snapzy 명령으로 캡처할 수 있게 합니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить приложениям и ИИ-агентам делать снимки командой snapzy"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép ứng dụng và AI agent chụp màn hình bằng lệnh snapzy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许应用和 AI 代理使用 snapzy 命令截图"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許 App 和 AI 代理使用 snapzy 指令擷取畫面"
          }
        }
      }
    },
    "command-line.access-title": {
      "comment": "Settings row title: enable the snapzy command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff per Befehlszeile"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Command line access"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso por línea de comandos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès en ligne de commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドラインからのアクセス"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령줄 접근"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ из командной строки"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy cập bằng dòng lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令行访问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命令列存取"
          }
        }
      }
    },
    "command-line.allowed-apps-description": {
      "comment": "Settings row description for the allowed apps list",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, die den Befehl snapzy verwenden wollten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that asked to use the snapzy command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que pidieron usar el comando snapzy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps ayant demandé à utiliser la commande snapzy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "snapzy コマンドの使用を求めたアプリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "snapzy 명령 사용을 요청한 앱"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложения, запрашивавшие команду snapzy"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các ứng dụng đã xin dùng lệnh snapzy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求使用 snapzy 命令的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求使用 snapzy 指令的 App"
          }
        }
      }
    },
    "command-line.allowed-apps-empty": {
      "comment": "Shown when no app has asked to use the snapzy command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine App hat gefragt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No app has asked yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna app lo ha pedido todavía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app ne l’a encore demandé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ要求したアプリはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 요청한 앱이 없습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ни одно приложение не запрашивало"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có ứng dụng nào xin quyền"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有应用请求"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有 App 提出要求"
          }
        }
      }
    },
    "command-line.allowed-apps-title": {
      "comment": "Settings row title: apps allowed to use the snapzy command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaubte Apps"
          }
        },
        "en": {
          "stringUnit": {
