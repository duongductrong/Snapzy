    "command-line.prompt-message": {
      "comment": "Body of the snapzy command permission alert; %@ is the command, e.g. capture window",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie hat „snapzy %@“ ausgeführt. Wenn du es erlaubst, können diese App und alles, was sie startet, über Snapzy deine Bildschirme und Fenster aufnehmen. Du kannst das später unter Einstellungen → Befehlszeile ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It ran “snapzy %@”. If you allow it, this app and anything it runs can capture your displays and windows through Snapzy. You can change this later in Settings → Command Line."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutó “snapzy %@”. Si lo permites, esta app y todo lo que ejecute podrá capturar tus pantallas y ventanas con Snapzy. Puedes cambiarlo más tarde en Ajustes → Línea de comandos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a exécuté « snapzy %@ ». Si vous l’autorisez, cette app et tout ce qu’elle lance pourront capturer vos écrans et fenêtres avec Snapzy. Vous pourrez modifier ce choix plus tard dans Réglages → Ligne de commande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「snapzy %@」が実行されました。許可すると、このアプリとそこから実行されるものはすべて Snapzy を通じてディスプレイやウインドウをキャプチャできます。あとで「設定 → コマンドライン」で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“snapzy %@” 명령을 실행했습니다. 허용하면 이 앱과 이 앱이 실행하는 모든 항목이 Snapzy를 통해 디스플레이와 윈도우를 캡처할 수 있습니다. 나중에 설정 → 명령줄에서 변경할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно запустило «snapzy %@». Если разрешить, это приложение и всё, что оно запускает, смогут снимать ваши дисплеи и окна через Snapzy. Изменить это можно позже в Настройках → Командная строка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này đã chạy “snapzy %@”. Nếu cho phép, ứng dụng này và mọi thứ nó chạy có thể chụp màn hình và cửa sổ của bạn qua Snapzy. Bạn có thể thay đổi sau trong Cài đặt → Dòng lệnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它运行了“snapzy %@”。如果允许，此应用及其运行的任何程序都可以通过 Snapzy 截取你的显示器和窗口。你可以稍后在“设置 → 命令行”中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它執行了「snapzy %@」。若允許，此 App 及其執行的任何程式都能透過 Snapzy 擷取你的顯示器和視窗。你可以稍後在「設定 → 命令列」中更改。"
          }
        }
      }
    },
    "command-line.prompt-title": {
      "comment": "Title of the alert asking whether an app may use the snapzy command; %@ is the app name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ möchte deinen Bildschirm mit Snapzy aufnehmen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” wants to capture your screen with Snapzy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” quiere capturar tu pantalla con Snapzy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » veut capturer votre écran avec Snapzy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
