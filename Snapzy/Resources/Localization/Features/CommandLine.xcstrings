          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps autorisées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されたアプリ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용된 앱"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешённые приложения"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng được phép"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许的应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許的 App"
          }
        }
      }
    },
    "command-line.capture-toast": {
      "comment": "Toast when another app captured the screen via the snapzy command; %@ is the app name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat den Bildschirm mit dem Befehl snapzy aufgenommen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ captured the screen with the snapzy command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ capturó la pantalla con el comando snapzy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a capturé l’écran avec la commande snapzy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が snapzy コマンドで画面をキャプチャしました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) snapzy 명령으로 화면을 캡처했습니다"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ сделало снимок экрана командой snapzy"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã chụp màn hình bằng lệnh snapzy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通过 snapzy 命令截取了屏幕"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 透過 snapzy 指令擷取了螢幕"
          }
        }
      }
    },
    "command-line.copy-command-button": {
      "comment": "Button: copy the Homebrew command that adds the snapzy command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl kopieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy Command"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copiar comando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Copier la commande"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドをコピー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 복사"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопировать команду"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sao chép lệnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拷貝指令"
          }
        }
      }
    },
    "command-line.error-blocked": {
      "comment": "Error: a regular file occupies the link path; %@ is the path",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existiert bereits und ist kein Link. Entferne es und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ already exists and isn’t a link. Remove it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya existe y no es un enlace. Elimínalo y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ existe déjà et n’est pas un lien. Supprimez-le, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は既に存在し、リンクではありません。削除してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 이미 있으며 링크가 아닙니다. 제거한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже существует и не является ссылкой. Удалите его и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã tồn tại và không phải liên kết. Hãy xóa nó rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是链接。请将其移除后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已存在且不是連結。請將其移除後再試一次。"
          }
        }
      }
    },
    "command-line.error-cancelled": {
      "comment": "Error: the administrator password prompt was cancelled",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung wurde abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The change was cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se canceló el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La modification a été annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更はキャンセルされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경이 취소되었습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменение отменено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi đã bị hủy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改已取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "變更已取消。"
          }
        }
      }
    },
    "command-line.error-helper-missing": {
      "comment": "Error: this Snapzy build has no snapzy command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Snapzy-Kopie enthält den Befehl snapzy nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This copy of Snapzy doesn’t include the snapzy command."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de Snapzy no incluye el comando snapzy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette copie de Snapzy n’inclut pas la commande snapzy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Snapzy には snapzy コマンドが含まれていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Snapzy 사본에는 snapzy 명령이 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой копии Snapzy нет команды snapzy."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản Snapzy này không có lệnh snapzy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Snapzy 副本不包含 snapzy 命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Snapzy 副本不包含 snapzy 指令。"
          }
        }
      }
    },
    "command-line.error-homebrew-link-missing": {
      "comment": "Error: Homebrew should link the snapzy command, not Snapzy; %@ is the brew command",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy wurde mit Homebrew installiert, das den Befehl snapzy hinzufügt. Führe %@ im Terminal aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy was installed with Homebrew, which adds the snapzy command. Run %@ in Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy se instaló con Homebrew, que añade el comando snapzy. Ejecuta %@ en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy a été installée avec Homebrew, qui ajoute la commande snapzy. Exécutez %@ dans le Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy は Homebrew でインストールされており、snapzy コマンドは Homebrew が追加します。ターミナルで %@ を実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy는 Homebrew로 설치되었으며 snapzy 명령은 Homebrew가 추가합니다. 터미널에서 %@ 을(를) 실행하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy установлена через Homebrew, которая добавляет команду snapzy. Выполните %@ в Терминале."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy được cài bằng Homebrew, và Homebrew sẽ thêm lệnh snapzy. Hãy chạy %@ trong Terminal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 是通过 Homebrew 安装的，snapzy 命令由 Homebrew 添加。请在终端中运行 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 是透過 Homebrew 安裝的，snapzy 指令由 Homebrew 加入。請在終端機中執行 %@。"
          }
        }
      }
    },
    "command-line.error-occupied": {
      "comment": "Error: another tool's link occupies the path; %1$@ is the path, %2$@ the link target",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verweist bereits auf %2$@. Entferne diesen Link und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already links to %2$@. Remove that link, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ya enlaza a %2$@. Elimina ese enlace y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pointe déjà vers %2$@. Supprimez ce lien, puis réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は既に %2$@ にリンクしています。そのリンクを削除してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@이(가) 이미 %2$@에 연결되어 있습니다. 해당 링크를 제거한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ уже указывает на %2$@. Удалите эту ссылку и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ đang trỏ tới %2$@. Hãy xóa liên kết đó rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已链接到 %2$@。请移除该链接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已連結到 %2$@。請移除該連結後再試一次。"
          }
        }
      }
    },
    "command-line.error-temporary-location": {
      "comment": "Error: Snapzy runs from a disk image or quarantine location",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebe Snapzy zuerst in den Ordner „Programme“. Es läuft gerade von einem temporären Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Snapzy to the Applications folder first. It is running from a temporary location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero mueve Snapzy a la carpeta Aplicaciones. Se está ejecutando desde una ubicación temporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez d’abord Snapzy dans le dossier Applications. Elle s’exécute depuis un emplacement temporaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に Snapzy を「アプリケーション」フォルダに移動してください。一時的な場所から実行されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 Snapzy를 응용 프로그램 폴더로 옮기세요. 임시 위치에서 실행 중입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала переместите Snapzy в папку «Программы». Сейчас она запущена из временного места."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy chuyển Snapzy vào thư mục Applications trước. Snapzy đang chạy từ một vị trí tạm thời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先将 Snapzy 移到“应用程序”文件夹。它正在从临时位置运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先將 Snapzy 移到「應用程式」檔案夾。它正從暫時位置執行。"
          }
        }
      }
    },
    "command-line.hero-subtitle": {
      "comment": "Command Line settings page subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Apps und KI-Agenten mit dem snapzy-Befehl aufnehmen und lege fest, wer ihn nutzen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
