    "video-editor.ai.layout-description": {
      "comment": "Settings › AI row description for the Video Editor AI layout",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidebar keeps the whole conversation and each edit beside the editor. Dock is a compact prompt floating over the player."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Seitenleiste zeigt die ganze Unterhaltung und jede Änderung neben dem Editor. Das Dock ist eine kompakte Eingabe über dem Player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra lateral conserva toda la conversación y cada edición junto al editor. El dock es un campo compacto flotando sobre el reproductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre latérale garde toute la conversation et chaque modification à côté de l’éditeur. Le dock est une zone de saisie compacte flottant sur le lecteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרגל הצד שומר את כל השיחה ואת כל עריכה לצד העורך. המעגן הוא שדה קלט קומפקטי שצף מעל הנגן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイドバーでは会話全体と各編集をエディタの横に表示します。ドックはプレーヤー上に浮かぶコンパクトな入力欄です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사이드바는 대화 전체와 각 편집 내용을 편집기 옆에 보여 줍니다. 독은 플레이어 위에 떠 있는 간결한 입력창입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Боковая панель показывает весь диалог и каждую правку рядом с редактором. Док — компактное поле ввода над плеером."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh bên giữ toàn bộ cuộc trò chuyện và từng chỉnh sửa bên cạnh trình chỉnh sửa. Dock là ô nhập gọn nổi phía trên trình phát."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "侧边栏会在编辑器旁保留完整对话和每一次编辑。程序坞是悬浮在播放器上方的紧凑输入框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "側邊欄會在編輯器旁保留完整對話和每一次編輯。Dock 是浮在播放器上方的精簡輸入框。"
          }
        }
      }
    },
