    "video-editor.speed-zoom-overlap-hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bereich überschneidet sich mit einem Zoom – der Zoom wird mit der angepassten Geschwindigkeit abgespielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This region overlaps a zoom — the zoom plays at the adjusted speed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta región se solapa con un zoom: el zoom se reproduce a la velocidad ajustada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette zone chevauche un zoom — le zoom est lu à la vitesse ajustée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטע הזה חופף לזום — הזום יתנגן במהירות המותאמת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この領域はズームと重なっています。ズームは調整後の速度で再生されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구간은 줌과 겹칩니다 — 줌은 조정된 속도로 재생됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот участок перекрывается с зумом — зум воспроизводится с изменённой скоростью."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đoạn này chồng với vùng zoom — zoom sẽ phát ở tốc độ đã điều chỉnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此区域与缩放重叠——缩放将以调整后的速度播放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此區域與縮放重疊——縮放將以調整後的速度播放。"
          }
        }
      }
