        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes ediciones de video no guardadas. ¿Quieres guardar antes de cerrar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez des modifications vidéo non enregistrées. Voulez-vous sauvegarder avant de fermer ?"
