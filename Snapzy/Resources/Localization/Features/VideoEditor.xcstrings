    "video-editor.ai.empty-subtitle": {
      "comment": "Empty state subtitle of the Video Editor AI panel",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schneide, zoome, beschleunige oder gestalte das Video um. Jede Änderung wird hier aufgelistet und lässt sich in einem Schritt rückgängig machen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cut, zoom, speed up or restyle the video. Every change is listed here and can be undone in one step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corta, haz zoom, acelera o cambia el estilo del vídeo. Cada cambio aparece aquí y se puede deshacer en un solo paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coupez, zoomez, accélérez ou restylez la vidéo. Chaque modification est listée ici et s’annule en une seule étape."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חתכו, הגדילו, האיצו או שנו את סגנון הווידאו. כל שינוי מופיע כאן וניתן לבטל אותו בצעד אחד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動画のカット、ズーム、速度変更、スタイル変更ができます。すべての変更がここに一覧表示され、1回の操作で元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영상을 자르고, 확대하고, 빠르게 하거나 스타일을 바꿔 보세요. 모든 변경 사항이 여기에 표시되며 한 번에 되돌릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обрезайте, увеличивайте, ускоряйте или меняйте оформление видео. Каждое изменение отображается здесь и отменяется одним шагом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắt, phóng to, tăng tốc hoặc đổi kiểu video. Mọi thay đổi đều hiển thị ở đây và hoàn tác được trong một bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪切、缩放、加速或调整视频样式。每项更改都会列在这里，并可一步撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪下、縮放、加速或調整影片樣式。每項變更都會列在這裡，並可一步復原。"
          }
        }
      }
    },
