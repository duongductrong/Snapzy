        }
      }
    },
    "video-editor.smart-auto-zoom-description": {
      "comment": "Description of Smart Auto-Zoom behavior in the video editor sidebar",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoomt auf Klicks, Ziehen und Eingaben, passt den Ausschnitt an UI-Ergebnisse an und zoomt bei Wechseln aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zooms into clicks, drags, and typing, reframes for UI results, and zooms out cleanly on transitions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acerca clics, arrastres y escritura, reencuadra según los resultados de la interfaz y aleja al cambiar de pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoome sur les clics, glissements et saisies, recadre sur les résultats d'interface et dézoome lors des transitions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקרב ללחיצות, גרירות והקלדה, מתאים מסגור לתוצאות בממשק ומתרחק במעברי מסך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリック・ドラッグ・入力にズームし、UIの結果に合わせて構図を調整し、画面遷移時に滑らかにズームアウトします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭, 드래그, 입력에 줌인하고 UI 결과에 맞춰 프레임을 조정하며 화면 전환 시 자연스럽게 줌아웃합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приближает клики, перетаскивания и ввод, подстраивает кадр под результат интерфейса и отдаляет при переходах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phóng to vào cú nhấp, kéo thả và gõ phím, tự chỉnh khung cho kết quả hiển thị và thu nhỏ mượt khi chuyển cảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放大点击、拖拽与输入，自动重构图展示界面结果，并在页面切换时平滑缩小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "放大點擊、拖曳與輸入，自動重構圖展示介面結果，並在頁面切換時平滑縮小。"
          }
        }
      }
    },
    "video-editor.smart-auto-zoom-dynamic": {
