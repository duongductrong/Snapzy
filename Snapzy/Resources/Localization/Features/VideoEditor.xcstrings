    "video-editor.ai.example-background": {
      "comment": "Example prompt in the Video Editor AI panel",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Farbverlauf-Hintergrund mit abgerundeten Ecken hinzu"
