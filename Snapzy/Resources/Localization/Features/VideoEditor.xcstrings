    "video-editor.cursor-baked-notice": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zeiger ist Teil der Bildpunkte dieses Videos. Aktiviere vor der Aufnahme die Studio-Aufnahme, um den Zeiger hier zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cursor is part of this video's pixels. Turn on Studio Recording before you record to edit the cursor here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cursor forma parte de los píxeles de este vídeo. Activa Grabación Studio antes de grabar para editar el cursor aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le curseur fait partie des pixels de cette vidéo. Activez l’enregistrement Studio avant d’enregistrer pour modifier le curseur ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסמן הוא חלק מהפיקסלים של הסרטון הזה. הפעילו הקלטת סטודיו לפני ההקלטה כדי לערוך את הסמן כאן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画のカーソルは映像に焼き込まれています。ここでカーソルを編集するには、録画前にスタジオ録画をオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상의 커서는 화면 픽셀에 포함되어 있습니다. 여기서 커서를 편집하려면 녹화 전에 스튜디오 녹화를 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсор вшит в изображение этого видео. Чтобы редактировать курсор здесь, включите студийную запись перед записью."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con trỏ đã nằm trong hình ảnh của video này. Bật Quay Studio trước khi quay để chỉnh con trỏ tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此视频的光标已嵌入画面。若要在此编辑光标，请在录制前开启工作室录制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此影片的游標已嵌入畫面。若要在此編輯游標，請在錄製前開啟工作室錄製。"
          }
        }
      }
    },
