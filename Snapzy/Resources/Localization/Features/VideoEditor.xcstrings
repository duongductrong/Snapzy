    "video-editor.manual-camera-control-only-in-manual-mode": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die manuelle Kamerasteuerung ist nur im manuellen Modus verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual camera control is available only in Manual mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El control manual de la cámara solo está disponible en el modo Manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contrôle manuel de la caméra est disponible uniquement en mode manuel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליטה ידנית במצלמה זמינה רק במצב ידני."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動カメラ制御は手動モードでのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 카메라 제어는 수동 모드에서만 가능합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ручное управление камерой доступно только в ручном режиме."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều khiển camera Thủ công chỉ khả dụng trong chế độ Thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动相机控制仅在手动模式下可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動相機控制僅在手動模式下可用。"
          }
        }
      }
    },
    "video-editor.manual-mode-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im manuellen Modus bleibt der Kameraausschnitt unverändert. Wechseln Sie zu „Auto“, wenn dieses Zoomelement der Maus folgen soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual mode keeps camera framing fixed. Switch to Auto when this zoom item should follow the mouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo manual mantiene fijo el encuadre de la cámara. Cambie a Automático cuando este elemento de zoom deba seguir al mouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode manuel maintient le cadrage de la caméra fixe. Basculez sur Auto lorsque cet élément de zoom doit suivre la souris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במצב ידני מסגור המצלמה קבוע. עבור למצב אוטומטי כשפריט הזום צריך לעקוב אחר העכבר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動モードでは、カメラのフレーミングが固定されます。このズーム項目がマウスに追従する必要がある場合は、「自動」に切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수동 모드에서는 카메라 프레임이 고정된 상태로 유지됩니다. 이 확대/축소 항목이 마우스를 따라야 하는 경우 자동으로 전환하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В ручном режиме кадр камеры остается фиксированным. Переключитесь на «Авто», когда этот элемент масштабирования должен следовать за мышью."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ Thủ công giữ khung hình camera cố định. Hãy chuyển sang Tự động khi mục zoom này cần bám theo chuột."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动模式使相机取景保持固定。当此缩放项目应跟随鼠标时切换到“自动”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手動模式使相機取景保持固定。當此縮放項目應跟隨鼠標時切換到“自動”。"
          }
        }
      }
    },
