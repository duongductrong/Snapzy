    "video-editor.captions-error-denied": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für Snapzy deaktiviert. Erlaube sie unter Systemeinstellungen › Datenschutz & Sicherheit › Spracherkennung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech Recognition is off for Snapzy. Allow it in System Settings › Privacy & Security › Speech Recognition, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para Snapzy. Actívalo en Ajustes del Sistema › Privacidad y seguridad › Reconocimiento de voz y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour Snapzy. Autorisez-la dans Réglages Système › Confidentialité et sécurité › Reconnaissance vocale, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זיהוי דיבור כבוי עבור Snapzy. אפשרו אותו בהגדרות המערכת › פרטיות ואבטחה › זיהוי דיבור ונסו שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzyの音声認識がオフになっています。システム設定 › プライバシーとセキュリティ › 音声認識で許可してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy의 음성 인식이 꺼져 있습니다. 시스템 설정 › 개인정보 보호 및 보안 › 음성 인식에서 허용한 후 다시 시도하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи для Snapzy выключено. Разрешите его в Системных настройках › Конфиденциальность и безопасность › Распознавание речи и повторите попытку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy chưa được phép nhận dạng giọng nói. Hãy bật trong Cài đặt hệ thống › Quyền riêng tư & Bảo mật › Nhận dạng giọng nói rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 的语音识别已关闭。请在“系统设置 › 隐私与安全性 › 语音识别”中允许，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 的語音辨識已關閉。請在「系統設定 › 隱私權與安全性 › 語音辨識」中允許，然後再試一次。"
          }
        }
      }
    },
