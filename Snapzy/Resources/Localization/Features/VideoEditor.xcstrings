    "video-editor.captions-error-unsupported": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung auf dem Gerät ist für %@ auf diesem Mac nicht verfügbar. Wähle eine andere Sprache."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition isn’t available for %@ on this Mac. Choose another language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo no está disponible para %@ en este Mac. Elige otro idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l’appareil n’est pas disponible pour %@ sur ce Mac. Choisissez une autre langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זיהוי דיבור במכשיר אינו זמין עבור %@ במק הזה. בחרו שפה אחרת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacでは%@のオンデバイス音声認識を利用できません。別の言語を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서는 %@에 대한 기기 내 음성 인식을 사용할 수 없습니다. 다른 언어를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи на устройстве недоступно для языка «%@» на этом Mac. Выберите другой язык."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này không hỗ trợ nhận dạng giọng nói trên máy cho %@. Hãy chọn ngôn ngữ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 不支持%@的设备端语音识别。请选择其他语言。"
