    "video-editor.text-select-or-create-hint": {
      "comment": "Helper prompt shown in Style or Motion tab when no text overlay is currently selected",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Titel auf der Leinwand aus oder füge einen an der Abspielposition hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a title on the canvas or add one at the playhead to customize its style and motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un título en el lienzo o añade uno en el cabezal para personalizar su estilo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un titre sur le canevas ou ajoutez-en un à la tête de lecture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר כותרת על הקנבס או הוסף אחת במיקום הניגון כדי להתאים עיצוב ותנועה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバス上のタイトルを選択するか、再生ヘッドに追加してスタイルとモーションを編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스에서 제목을 선택하거나 재생 헤드에 새 제목을 추가해 스타일과 모션을 편집하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите титр на холсте или добавьте новый в позиции курсора для настройки стиля и анимации."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một tiêu đề trên khung video hoặc bấm + Thêm tiêu đề để tuỳ chỉnh thiết kế và hiệu ứng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上选择一个标题，或在播放头位置添加标题以自定义样式与动效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布上選擇一個標題，或在播放頭位置新增標題以自訂樣式與動效。"
          }
        }
      }
    },
