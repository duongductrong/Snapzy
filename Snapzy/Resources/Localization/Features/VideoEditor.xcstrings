    "video-editor.captions-text-relationship-hint": {
      "comment": "Concise helper description explaining how Captions and Text work together",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wandle einzelne Zeilen oder das gesamte Transkript in Text (Aa) um – für eigene Stile, freie Positionierung und individuelle Animationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert key lines or the full transcript to Text (Aa) for independent presets, free drag placement, and per-item motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte frases clave o todo el guion en Texto (Aa) para usar estilos propios, posición libre y animación individual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Convertissez une ligne ou tout le script en Texte (Aa) pour un style, une position glissable et une animation propres à chaque élément."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המר שורות נבחרות או את כל התמליל לטקסט (Aa) לעיצוב עצמאי, גרירה חופשית ואנימציה לכל פריט."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要なフレーズや全字幕をテキスト (Aa) に変換すると、個別のスタイル・自由配置・モーションを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핵심 문장이나 전체 자막을 텍스트(Aa)로 전환하면 항목별 프리셋, 자유 드래그 배치, 개별 모션을 적용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразуйте отдельные реплики или весь текст в Текст (Aa) для индивидуального стиля, свободного перемещения и своей анимации."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tách từng câu nhấn hoặc toàn bộ phụ đề sang Văn bản (Aa) để gắn preset riêng, kéo thả tự do và chỉnh chuyển động độc lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将重点句或全部字幕转为独立文本 (Aa)，即可单独套用预设、自由拖拽位置并定制进出场动画。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將重點句或全部字幕轉為獨立文字 (Aa)，即可單獨套用預設、自由拖曳位置並自訂進出動畫。"
          }
        }
      }
    },
