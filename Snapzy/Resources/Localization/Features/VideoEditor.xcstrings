    "video-editor.unsaved-changes-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben nicht gespeicherte Videobearbeitungen. Möchten Sie vor dem Schließen speichern?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have unsaved video edits. Do you want to save before closing?"
