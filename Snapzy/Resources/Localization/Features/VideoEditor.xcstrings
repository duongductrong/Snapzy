    "video-editor.motion-blur-description": {
      "comment": "Description of motion blur in the video editor sidebar",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt GPU-Bewegungsunschärfe bei schnellen Zooms, Kameraschwenks und schnellen Cursorbewegungen hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds GPU shutter-angle blur during fast zoom transitions, pans, and cursor flicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade desenfoque por ángulo de obturación con GPU en zooms rápidos, paneos y movimientos del cursor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un flou GPU naturel lors des transitions de zoom rapides, panoramiques et mouvements du curseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסיף טשטוש תנועה מואץ GPU בזום מהיר, תנועות מצלמה ותזוזות סמן מהירות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "素早いズーム遷移・カメラ移動・カーソル移動にGPUシャッターブラーを適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 줌 전환, 카메라 패닝, 커서 이동에 GPU 셔터 블러를 적용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет аппаратное размытие при быстрых переходах зума, панорамировании и резких движениях курсора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm hiệu ứng mờ theo góc màn trập bằng GPU khi thu phóng nhanh, lia máy và di chuyển con trỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速缩放过渡、镜头平移和快速移动光标时添加 GPU 快门角模糊。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在快速縮放過渡、鏡頭平移與快速移動游標時加入 GPU 快門角模糊。"
          }
        }
      }
    },
