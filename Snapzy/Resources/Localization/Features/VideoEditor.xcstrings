    "video-editor.press-z-to-add-zoom": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie Z, um einen Zoom am Abspielkopf hinzuzufügen, oder klicken Sie auf ein Zoomelement in der Timeline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Z to add a zoom at the playhead, or click a zoom item in the timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presione Z para agregar un zoom en el cursor de reproducción o haga clic en un elemento de zoom en la línea de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Z pour ajouter un zoom au niveau de la tête de lecture ou cliquez sur un élément de zoom dans la timeline."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לחץ Z כדי להוסיף זום במיקום הסמן, או לחץ על פריט זום בציר הזמן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Z を押して再生ヘッドにズームを追加するか、タイムライン内のズーム項目をクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 헤드에 확대/축소를 추가하려면 Z를 누르거나 타임라인에서 확대/축소 항목을 클릭하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите Z, чтобы добавить масштаб к курсору воспроизведения, или щелкните элемент масштабирования на временной шкале."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn Z để thêm một zoom tại đầu phát hoặc bấm vào một mục zoom trên timeline."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Z 可在播放头位置添加缩放，或点按时间线中的缩放片段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Z 可在播放頭位置加入縮放，或點按時間軸中的縮放片段。"
          }
        }
      }
    },
