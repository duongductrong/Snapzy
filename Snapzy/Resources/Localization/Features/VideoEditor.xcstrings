        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장되지 않은 동영상 수정사항이 있습니다. 닫기 전에 저장하시겠습니까?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас есть несохраненные изменения видео. Хотите сохранить перед закрытием?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chỉnh sửa video chưa lưu. Bạn có muốn lưu trước khi đóng không?"
