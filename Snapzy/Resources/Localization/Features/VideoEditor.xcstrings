    "video-editor.ai.consent-title": {
      "comment": "Alert title before the first Video Editor AI prompt goes to an off-device provider. %@ is the provider name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this video’s timeline to %@?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Timeline dieses Videos an %@ senden?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar la línea de tiempo de este vídeo a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer la timeline de cette vidéo à %@ ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשלוח את ציר הזמן של הסרטון הזה אל %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この動画のタイムラインを%@に送信しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 동영상의 타임라인을 %@(으)로 보낼까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить таймлайн этого видео в %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi timeline của video này tới %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此视频的时间线发送到 %@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將此影片的時間軸傳送到 %@ 嗎？"
          }
        }
      }
    },
    "video-editor.ai.consent-message": {
      "comment": "Alert message before the first Video Editor AI prompt goes to an off-device provider. %@ is the server host",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To answer, the video’s timeline (clips, zooms, speeds, frame and audio settings), text read off the screen, what is said (transcribed on this Mac) and, when sending images is on, video frames are sent to %@. Snapzy asks once for each provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Antwort werden die Timeline des Videos (Clips, Zooms, Tempo, Rahmen- und Audioeinstellungen), auf dem Bildschirm erkannter Text, das Gesprochene (auf diesem Mac transkribiert) und, wenn das Senden von Bildern aktiv ist, Videobilder an %@ gesendet. Snapzy fragt einmal pro Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder, la línea de tiempo del vídeo (clips, zooms, velocidades, ajustes de marco y audio), el texto leído en pantalla, lo que se dice (transcrito en este Mac) y, si el envío de imágenes está activado, fotogramas del vídeo se envían a %@. Snapzy lo pregunta una vez por proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour répondre, la timeline de la vidéo (clips, zooms, vitesses, réglages du cadre et du son), le texte lu à l’écran, ce qui est dit (transcrit sur ce Mac) et, si l’envoi d’images est activé, des images de la vidéo sont envoyées à %@. Snapzy ne le demande qu’une fois par fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לענות, ציר הזמן של הסרטון (קליפים, זומים, מהירויות, הגדרות מסגרת ושמע), טקסט שנקרא מהמסך, מה שנאמר (מתומלל במק הזה) ו – כשהאפשרות לשליחת תמונות פעילה – פריימים מהסרטון נשלחים אל %@. ‏Snapzy שואלת פעם אחת לכל ספק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答のため、動画のタイムライン（クリップ、ズーム、速度、フレームとオーディオの設定）、画面から読み取ったテキスト、話された内容（このMacで文字起こし）、画像の送信がオンの場合は動画のフレームが%@に送信されます。確認はプロバイダごとに1回だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변하기 위해 동영상의 타임라인(클립, 확대, 속도, 프레임 및 오디오 설정), 화면에서 읽은 텍스트, 말한 내용(이 Mac에서 받아쓰기), 그리고 이미지 보내기가 켜져 있으면 동영상 프레임이 %@(으)로 전송됩니다. Snapzy는 제공자마다 한 번만 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ответа провайдеру %@ отправляются таймлайн видео (клипы, зумы, скорость, настройки кадра и звука), текст с экрана, произнесённое (расшифровано на этом Mac) и, если отправка изображений включена, кадры видео. Snapzy спрашивает один раз для каждого провайдера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trả lời, timeline của video (clip, zoom, tốc độ, thiết lập khung hình và âm thanh), chữ đọc được trên màn hình, lời nói (chép lời ngay trên máy Mac này) và, khi bật gửi ảnh, các khung hình video sẽ được gửi tới %@. Snapzy chỉ hỏi một lần cho mỗi nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了回答，视频的时间线（片段、缩放、速度、画面与音频设置）、从屏幕读取的文字、说话内容（在这台 Mac 上转写）以及在开启发送图像时的视频画面会发送到 %@。Snapzy 对每个提供方只询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了回答，影片的時間軸（片段、縮放、速度、畫面與音訊設定）、從螢幕讀取的文字、說話內容（在這台 Mac 上轉寫）以及在開啟傳送影像時的影片畫面會傳送到 %@。Snapzy 對每個提供者只詢問一次。"
          }
        }
      }
    },
    "video-editor.ai.consent-message-cli": {
      "comment": "Alert message before the first Video Editor AI prompt goes to an agent CLI. %@ is the CLI name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gets the video’s timeline (clips, zooms, speeds, frame and audio settings), text read off the screen, what is said (transcribed on this Mac) and, when sending images is on, video frames, and sends them to its model provider. It may also load your own MCP servers, hooks and instructions. Snapzy asks once for each provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erhält die Timeline des Videos (Clips, Zooms, Tempo, Rahmen- und Audioeinstellungen), auf dem Bildschirm erkannten Text, das Gesprochene (auf diesem Mac transkribiert) und, wenn das Senden von Bildern aktiv ist, Videobilder und sendet sie an seinen Modellanbieter. Es kann auch deine eigenen MCP-Server, Hooks und Anweisungen laden. Snapzy fragt einmal pro Anbieter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recibe la línea de tiempo del vídeo (clips, zooms, velocidades, ajustes de marco y audio), el texto leído en pantalla, lo que se dice (transcrito en este Mac) y, si el envío de imágenes está activado, fotogramas del vídeo, y los envía a su proveedor de modelos. También puede cargar tus propios servidores MCP, hooks e instrucciones. Snapzy lo pregunta una vez por proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reçoit la timeline de la vidéo (clips, zooms, vitesses, réglages du cadre et du son), le texte lu à l’écran, ce qui est dit (transcrit sur ce Mac) et, si l’envoi d’images est activé, des images de la vidéo, puis les envoie à son fournisseur de modèles. Il peut aussi charger vos propres serveurs MCP, hooks et instructions. Snapzy ne le demande qu’une fois par fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ מקבל את ציר הזמן של הסרטון (קליפים, זומים, מהירויות, הגדרות מסגרת ושמע), טקסט שנקרא מהמסך, מה שנאמר (מתומלל במק הזה) ו – כשהאפשרות לשליחת תמונות פעילה – פריימים מהסרטון, ושולח אותם לספק המודל שלו. הוא עשוי גם לטעון שרתי MCP, hooks והוראות משלכם. ‏Snapzy שואלת פעם אחת לכל ספק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は動画のタイムライン（クリップ、ズーム、速度、フレームとオーディオの設定）、画面から読み取ったテキスト、話された内容（このMacで文字起こし）、画像の送信がオンの場合は動画のフレームを受け取り、モデルプロバイダに送信します。独自のMCPサーバ、フック、指示を読み込むこともあります。確認はプロバイダごとに1回だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 동영상의 타임라인(클립, 확대, 속도, 프레임 및 오디오 설정), 화면에서 읽은 텍스트, 말한 내용(이 Mac에서 받아쓰기), 그리고 이미지 보내기가 켜져 있으면 동영상 프레임을 받아 모델 제공자에게 보냅니다. 사용자의 MCP 서버, 훅, 지침을 불러올 수도 있습니다. Snapzy는 제공자마다 한 번만 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ получает таймлайн видео (клипы, зумы, скорость, настройки кадра и звука), текст с экрана, произнесённое (расшифровано на этом Mac) и, если отправка изображений включена, кадры видео, и отправляет их своему провайдеру модели. Он также может загрузить ваши MCP-серверы, хуки и инструкции. Snapzy спрашивает один раз для каждого провайдера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nhận timeline của video (clip, zoom, tốc độ, thiết lập khung hình và âm thanh), chữ đọc được trên màn hình, lời nói (chép lời ngay trên máy Mac này) và, khi bật gửi ảnh, các khung hình video, rồi gửi tới nhà cung cấp mô hình của nó. Nó cũng có thể nạp MCP server, hook và chỉ dẫn riêng của bạn. Snapzy chỉ hỏi một lần cho mỗi nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会获取视频的时间线（片段、缩放、速度、画面与音频设置）、从屏幕读取的文字、说话内容（在这台 Mac 上转写）以及在开启发送图像时的视频画面，并发送给其模型提供方。它也可能加载你自己的 MCP 服务器、钩子和指令。Snapzy 对每个提供方只询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會取得影片的時間軸（片段、縮放、速度、畫面與音訊設定）、從螢幕讀取的文字、說話內容（在這台 Mac 上轉寫）以及在開啟傳送影像時的影片畫面，並傳送給其模型提供者。它也可能載入你自己的 MCP 伺服器、掛鉤和指示。Snapzy 對每個提供者只詢問一次。"
          }
        }
      }
    },
