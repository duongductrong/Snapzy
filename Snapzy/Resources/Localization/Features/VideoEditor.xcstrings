    "video-editor.focus-margin-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt eine Stabilitätszone hinzu, damit kleine Cursorbewegungen die Kamera nicht ständig bewegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds a stability zone so tiny cursor motion does not keep nudging the camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega una zona de estabilidad para que el pequeño movimiento del cursor no siga empujando la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une zone de stabilité afin que les petits mouvements du curseur ne continuent pas à pousser la caméra."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסיף אזור יציבות כדי שתנועות קטנות של הסמן לא יזיזו את המצלמה כל הזמן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安定ゾーンを追加して、小さなカーソルの動きがカメラを微動し続けることを防ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 커서 움직임으로 인해 카메라가 계속 움직이지 않도록 안정성 영역을 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет зону стабильности, поэтому малейшее движение курсора не подталкивает камеру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm một vùng ổn định để chuyển động chuột rất nhỏ không liên tục đẩy camera."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加稳定区域，因此微小的光标运动不会不断推动相机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "添加穩定區域，因此微小的光標運動不會不斷推動相機。"
          }
        }
      }
    },
    "video-editor.follow-mouse": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Folgen Sie der Maus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir ratón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre la souris"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר העכבר"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスに追従"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 따라가기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следовать за мышью"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo chuột"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随鼠标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨鼠標"
          }
        }
      }
    },
    "video-editor.follow-mouse-active-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kameraposition folgt nur dann dem aufgezeichneten Mauspfad, wenn dieses Zoomelement aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera position follows the recorded mouse path only while this zoom item is active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición de la cámara sigue la ruta grabada del mouse solo mientras este elemento de zoom está activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position de la caméra suit le chemin de la souris enregistré uniquement lorsque cet élément de zoom est actif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מיקום המצלמה עוקב אחר מסלול העכבר שהוקלט רק בזמן שפריט הזום הזה פעיל."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このズーム項目がアクティブな間のみ、カメラの位置が記録されたマウスの軌跡に追従します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 위치는 이 확대/축소 항목이 활성화된 동안에만 기록된 마우스 경로를 따릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Положение камеры следует записанному пути мыши только тогда, когда этот элемент масштабирования активен."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí camera sẽ bám theo đường đi chuột đã ghi chỉ trong lúc mục zoom này hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当此缩放项目处于活动状态时，摄像机位置才会遵循记录的鼠标路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅當此縮放項目處於活動狀態時，攝像機位置才會遵循記錄的鼠標路徑。"
          }
        }
      }
    },
    "video-editor.follow-mouse-only-works-with-snapzy": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse funktioniert nur mit Videos, die von Snapzy aufgenommen wurden, nachdem die Mausverfolgung hinzugefügt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse only works with videos recorded by Snapzy after mouse tracking was added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse solo funciona con videos grabados por Snapzy después de que se agregó el seguimiento del mouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse ne fonctionne qu'avec les vidéos enregistrées par Snapzy après l'ajout du suivi de la souris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעקב אחר העכבר עובד רק עם סרטונים שהוקלטו ב־Snapzy אחרי שנוסף מעקב העכבר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「マウスに追従」は、マウストラッキングの追加後に Snapzy で録画したビデオでのみ機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse는 마우스 추적이 추가된 후 Snapzy에서 녹화한 비디오에서만 작동합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow Mouse работает только с видео, записанными Snapzy после добавления отслеживания мыши."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo chuột chỉ hoạt động với video do Snapzy ghi sau khi tính năng theo dõi chuột được thêm vào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟随鼠标”仅适用于添加鼠标跟踪后由 Snapzy 录制的视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“跟隨鼠標”僅適用於添加鼠標跟蹤後由 Snapzy 錄制的影片。"
          }
        }
      }
    },
