    "video-editor.text-empty-headline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge animierte Titel, Hinweise oder Bauchbinden direkt auf deiner Video-Timeline hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add animated titles, callouts, or lower thirds directly on your video timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade títulos animados, avisos o tercios inferiores directamente en la línea de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des titres animés, légendes ou bandeaux directement sur votre timeline vidéo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כותרות מונפשות, הערות או כתוביות תחתונות ישירות על ציר הזמן של הווידאו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーション付きタイトルや注釈、テロップをタイムラインに直接追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비디오 타임라인에 애니메이션 제목, 콜아웃 또는 하단 자막을 바로 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте анимированные титры, выноски и плашки прямо на таймлайн видео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tiêu đề động, chú thích hoặc dải chữ trực tiếp lên thanh thời gian video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在视频时间轴上添加动态标题、标注或字幕条。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在影片時間軸上新增動態標題、標註或字幕條。"
          }
        }
      }
    },
    "video-editor.text-empty-subheadline": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe Titel in der Vorschau zum Verschieben oder passe ihre Dauer auf der Timeline an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag any title on the preview to reposition it, or resize its bar on the timeline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra cualquier título en la vista previa para moverlo o ajusta su barra en la línea de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser un titre sur l’aperçu pour le déplacer, ou redimensionnez sa barre sur la timeline."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור כל כותרת בתצוגה המקדימה כדי להזיז אותה, או שנה את אורכה על ציר הזמן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビュー上でタイトルをドラッグして移動したり、タイムライン上で長さを調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리보기에서 제목을 드래그해 위치를 바꾸거나 타임라인에서 길이를 조절하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите титр на предпросмотре, чтобы сменить позицию, или измените его длительность на таймлайне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo trực tiếp tiêu đề trên khung xem trước để đổi vị trí, hoặc kéo thanh trên timeline để đổi thời lượng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在预览画面上拖动标题可调整位置，或在时间轴上调整时长。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在預覽畫面上拖動標題可調整位置，或在時間軸上調整時長。"
          }
        }
      }
    },
