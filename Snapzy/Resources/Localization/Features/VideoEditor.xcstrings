    "video-editor.ai.shortcut-description": {
      "comment": "Settings → Shortcuts description for the Video Editor AI prompt shortcut",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the AI prompt to edit the timeline by describing the change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Eingabe öffnen und die Timeline per Beschreibung bearbeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el aviso de IA para editar la línea de tiempo describiendo el cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre l’invite IA pour modifier la timeline en décrivant le changement."
