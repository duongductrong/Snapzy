          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружены существующие масштабирования"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có vùng zoom trên timeline"
          }
        },
        "zh-Hans": {
