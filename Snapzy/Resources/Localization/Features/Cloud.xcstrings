            "value": "Laden Sie ein zuvor exportiertes Snapzy-Cloud-Archiv, um dieses Formular vorab auszufüllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a previously exported Snapzy cloud archive to prefill this form."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargue un archivo en la nube Snapzy previamente exportado para completar previamente este formulario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez une archive cloud Snapzy précédemment exportée pour pré-remplir ce formulaire."
          }
