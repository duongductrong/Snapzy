    "cloud.custom-uploader.secret-candidates-header": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Felder sehen nach Zugangsdaten aus. Speichere sie als Secrets, damit die Werte im Schlüsselbund statt im Uploader liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These fields look like credentials. Store them as secrets so the values live in the Keychain instead of the uploader."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos campos parecen credenciales. Guárdalos como secretos para que los valores estén en el llavero y no en el uploader."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces champs ressemblent à des identifiants. Enregistrez-les comme secrets pour que les valeurs restent dans le trousseau plutôt que dans l’uploader."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השדות האלה נראים כמו אישורים. שמרו אותם כסודות כדי שהערכים יישמרו במחזיק המפתחות ולא במעלה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのフィールドは認証情報のようです。シークレットとして保存すると、値はアップローダーではなくキーチェーンに保管されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 필드는 자격 증명으로 보입니다. 비밀 값으로 저장하면 값이 업로더가 아닌 키체인에 보관됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти поля похожи на учетные данные. Сохраните их как секреты, чтобы значения хранились в связке ключей, а не в загрузчике."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường này trông giống thông tin xác thực. Hãy lưu chúng dưới dạng bí mật để giá trị nằm trong Chuỗi khóa thay vì trong trình tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些字段看起来像凭据。将它们存储为密钥，使其值保存在钥匙串中而不是上传器里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些欄位看起來像憑證。將它們儲存為密鑰，讓值保存在鑰匙圈中而非上傳器裡。"
          }
        }
      }
    },
    "cloud.custom-uploader.secret-name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
