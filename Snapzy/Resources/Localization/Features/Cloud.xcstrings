    "cloud.custom-uploader.delete-confirm-message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Uploads und Automationen, die diesen Uploader nutzen, schlagen fehl, bis du einen anderen auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud uploads and automations that use this uploader will fail until you choose another one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subidas a la nube y automatizaciones que usan este uploader fallarán hasta que elijas otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les envois vers le cloud et les automatisations qui utilisent cet uploader échoueront jusqu’à ce que vous en choisissiez un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאות לענן ואוטומציות שמשתמשות במעלה הזה ייכשלו עד שתבחרו מעלה אחר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップローダーを使うクラウドアップロードとオートメーションは、別のものを選ぶまで失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업로더를 사용하는 클라우드 업로드와 자동화는 다른 업로더를 선택할 때까지 실패합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки в облако и автоматизации, использующие этот загрузчик, будут завершаться ошибкой, пока вы не выберете другой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các lần tải lên đám mây và tự động hóa dùng trình tải lên này sẽ thất bại cho đến khi bạn chọn trình khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此上传器的云上传和自动化将失败，直到你选择其他上传器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此上傳器的雲端上傳和自動化將會失敗，直到你選擇其他上傳器。"
          }
        }
      }
    },
