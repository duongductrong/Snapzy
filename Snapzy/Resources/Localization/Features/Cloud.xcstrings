    "cloud-settings.google-setup-guide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בפרטי גישה משלך כדי לשמור על פרטיות. צור OAuth Client ID מסוג Desktop App ב־Google Cloud Console שלך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシー保護のため、ご自身の認証情報を使用します。Google Cloud Console で「デスクトップ アプリ」用の OAuth クライアント ID を作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng thông tin cấu hình của riêng bạn để bảo vệ quyền riêng tư. Tạo một Desktop App OAuth Client ID trong Google Cloud Console của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your own credentials to protect privacy. Create a Desktop App OAuth Client ID in your Google Cloud Console."
          }
        }
      }
    },
    "cloud-settings.hero-subtitle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Aufnahmen in deinen eigenen Speicher hoch und teile sie per Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload captures to your own storage and share them with a link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube tus capturas a tu propio almacenamiento y compártelas con un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez vos captures vers votre propre stockage et partagez-les avec un lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאת צילומים לאחסון משלך ושיתוף שלהם בקישור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャプチャを自分のストレージにアップロードし、リンクで共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캡처를 내 스토리지에 업로드하고 링크로 공유합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружайте снимки в собственное хранилище и делитесь ими по ссылке."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải ảnh chụp lên bộ nhớ của riêng bạn và chia sẻ bằng liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将截图上传到你自己的存储空间，并通过链接分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將截圖上傳到你自己的儲存空間，並透過連結分享。"
          }
        }
      }
    },
