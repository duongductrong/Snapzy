    "cloud-settings.imgbb-public-warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb-Links sind öffentlich. Jeder mit dem Link kann das Bild sehen. Lade also nichts Privates hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb links are public. Anyone with the link can view the image, so don't upload anything private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces de imgbb son públicos. Cualquiera con el enlace puede ver la imagen, así que no subas nada privado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens imgbb sont publics. Toute personne disposant du lien peut voir l’image : n’envoyez rien de privé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קישורי imgbb הם ציבוריים. כל מי שיש לו את הקישור יכול לראות את התמונה, לכן אל תעלו שום דבר פרטי."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb のリンクは公開されます。リンクを知っている人は誰でも画像を閲覧できるため、非公開にしたいものはアップロードしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 링크는 공개됩니다. 링크가 있는 누구나 이미지를 볼 수 있으니 비공개 자료는 업로드하지 마세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылки imgbb публичны. Любой, у кого есть ссылка, может открыть изображение, поэтому не загружайте ничего личного."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết imgbb là công khai. Ai có liên kết cũng xem được ảnh, vì vậy đừng tải lên nội dung riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 链接是公开的。任何拿到链接的人都能查看图片，请勿上传私密内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 連結是公開的。任何取得連結的人都能檢視圖片，請勿上傳私密內容。"
          }
        }
      }
    },
    "cloud-settings.import-credentials-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy lädt die importierten Werte in den Editor. Ihre aktuell gespeicherte Konfiguration bleibt unverändert, bis Sie auf Speichern und Testen klicken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy will load the imported values into the editor. Your current saved configuration stays unchanged until you click Save & Test."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy cargará los valores importados en el editor. Su configuración guardada actual permanece sin cambios hasta que haga clic en Guardar y probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy chargera les valeurs importées dans l'éditeur. Votre configuration enregistrée actuelle reste inchangée jusqu'à ce que vous cliquiez sur Enregistrer et tester."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy תטען את הערכים המיובאים לטופס. ההגדרות השמורות הנוכחיות לא ישתנו עד שתלחץ ״שמירה ובדיקה״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy はインポートされた値をエディタにロードします。現在保存されている構成は、「保存してテスト」をクリックするまで変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy는 가져온 값을 편집기에 로드합니다. 현재 저장된 구성은 저장 및 테스트를 클릭할 때까지 변경되지 않은 상태로 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy загрузит импортированные значения в редактор. Текущая сохраненная конфигурация остается неизменной, пока вы не нажмете «Сохранить и протестировать»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy sẽ nạp các giá trị từ gói nhập vào biểu mẫu chỉnh sửa. Cấu hình đang lưu của bạn sẽ chưa thay đổi cho đến khi bạn bấm Lưu & Kiểm tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 会将导入的值加载到编辑器中。您当前保存的配置保持不变，直到您单击“保存并测试”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 會將導入的值加載到編輯器中。您當前保存的配置保持不變，直到您單擊“保存並測試”。"
          }
        }
      }
    },
    "cloud-settings.import-credentials-password-prompt": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihr Sicherheitskennwort ein, um Anmeldeinformationen über das aktuelle Cloud-Setup zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your protection password to import credentials over the current cloud setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese su contraseña de protección para importar credenciales a través de la configuración actual de la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez votre mot de passe de protection pour importer les informations d'identification sur la configuration cloud actuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן את סיסמת ההגנה כדי לייבא פרטים במקום הגדרות הענן הנוכחיות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保護パスワードを入力して、現在のクラウド設定に認証情報をインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 클라우드 설정을 통해 자격 증명을 가져오려면 보호 비밀번호를 입력하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите свой пароль защиты, чтобы импортировать учетные данные в текущую настройку облака."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mật khẩu bảo vệ để nhập thông tin đăng nhập đè lên cấu hình Cloud hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入您的保护密码以通过当前云设置导入凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入您的保護密碼以通過當前雲設置導入憑據。"
          }
        }
      }
    },
