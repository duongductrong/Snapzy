    "cloud-settings.incorrect-password-attempts": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falsches Passwort. Bitte versuchen Sie es erneut. (%d fehlgeschlagene Versuche)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect password. Please try again. (%d failed attempts)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña incorrecta. Por favor inténtalo de nuevo. (%d intentos fallidos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mot de passe incorrect. Veuillez réessayer. (%d tentatives échouées)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיסמה שגויה. נסה שוב. (%d ניסיונות כושלים)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードが間違っています。もう一度試してください。 (%d 回の試行に失敗しました)"
          }
        },
        "ko": {
          "stringUnit": {
