    "cloud-settings.imgbb-delete-info": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb bietet keine Lösch-API. Wenn du einen Upload in Snapzy löschst, öffnet sich die imgbb-Löschseite im Browser. imgbb akzeptiert Bilder bis 32 MB, keine Videos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb has no delete API. Deleting an upload in Snapzy opens its imgbb delete page in your browser. imgbb accepts images up to 32 MB, not videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb no tiene API de eliminación. Al eliminar una subida en Snapzy se abre su página de eliminación de imgbb en el navegador. imgbb acepta imágenes de hasta 32 MB, no videos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb n’a pas d’API de suppression. Supprimer un envoi dans Snapzy ouvre sa page de suppression imgbb dans le navigateur. imgbb accepte les images jusqu’à 32 Mo, pas les vidéos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ל-imgbb אין API למחיקה. מחיקת העלאה ב-Snapzy פותחת את דף המחיקה שלה ב-imgbb בדפדפן. ‏imgbb מקבל תמונות עד 32MB, לא סרטונים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb には削除 API がありません。Snapzy でアップロードを削除すると、ブラウザで imgbb の削除ページが開きます。imgbb は 32 MB までの画像に対応し、動画には対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb에는 삭제 API가 없습니다. Snapzy에서 업로드를 삭제하면 브라우저에서 imgbb 삭제 페이지가 열립니다. imgbb는 32MB 이하의 이미지만 지원하며 동영상은 지원하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У imgbb нет API для удаления. При удалении загрузки в Snapzy в браузере откроется страница удаления imgbb. imgbb принимает изображения до 32 МБ, но не видео."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb không có API xóa. Khi xóa một tệp đã tải lên trong Snapzy, trang xóa của imgbb sẽ mở trong trình duyệt. imgbb nhận ảnh tối đa 32 MB, không nhận video."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 没有删除 API。在 Snapzy 中删除上传会在浏览器中打开 imgbb 的删除页面。imgbb 支持最大 32 MB 的图片，不支持视频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 沒有刪除 API。在 Snapzy 中刪除上傳會在瀏覽器中開啟 imgbb 的刪除頁面。imgbb 支援最大 32 MB 的圖片，不支援影片。"
          }
        }
      }
    },
    "cloud-settings.imgbb-expiration-info": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb löscht jedes Bild nach dem gewählten Zeitraum. Bei „Dauerhaft“ bleiben Bilder erhalten, bis du sie löschst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb deletes each image after the selected period. Permanent keeps images until you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb elimina cada imagen tras el periodo elegido. Con Permanente, las imágenes se conservan hasta que las elimines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb supprime chaque image après la durée choisie. Avec Permanent, les images restent jusqu’à ce que vous les supprimiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏imgbb מוחק כל תמונה בתום התקופה שנבחרה. ‏'קבוע' שומר תמונות עד שתמחקו אותן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb は選択した期間が過ぎると画像を削除します。「無期限」を選ぶと、削除するまで画像が残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb는 선택한 기간이 지나면 이미지를 삭제합니다. 영구를 선택하면 직접 삭제할 때까지 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb удаляет каждое изображение по истечении выбранного срока. «Бессрочно» хранит изображения, пока вы их не удалите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb xóa mỗi ảnh sau khoảng thời gian đã chọn. Vĩnh viễn sẽ giữ ảnh cho đến khi bạn xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 会在所选时间后删除每张图片。选择“永久”则保留到你手动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "imgbb 會在所選時間後刪除每張圖片。選擇「永久」則保留到你手動刪除。"
          }
        }
      }
    },
