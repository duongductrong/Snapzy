    "cloud.custom-uploader.warning.removed-secret": {
      "comment": "Import warning; %1$@ is a {secret:NAME} token, %2$@ is the ShareX field name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@ wurde entfernt: Eine importierte Datei darf deine gespeicherten Secrets nicht verwenden. Füge deinen eigenen Schlüssel mit „Als Secret speichern“ oder im Editor hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ in %2$@ was removed: an imported file can’t use your saved secrets. Add your own key with Store as Secret or in the editor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitó %1$@ de %2$@: un archivo importado no puede usar tus secretos guardados. Añade tu propia clave con Guardar como secreto o en el editor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dans %2$@ a été supprimé : un fichier importé ne peut pas utiliser vos secrets enregistrés. Ajoutez votre propre clé avec Enregistrer comme secret ou dans l’éditeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ב-%2$@ הוסר: קובץ מיובא לא יכול להשתמש בסודות השמורים שלך. אפשר להוסיף מפתח משלך עם ״שמירה כסוד״ או בעורך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ を削除しました。読み込んだファイルは保存済みのシークレットを使えません。「シークレットとして保存」かエディタで自分のキーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@의 %1$@을(를) 제거했습니다. 가져온 파일은 저장된 비밀 값을 사용할 수 없습니다. 비밀 값으로 저장 또는 편집기에서 직접 키를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ в %2$@ удалён: импортированный файл не может использовать ваши сохранённые секреты. Добавьте свой ключ через «Сохранить как секрет» или в редакторе."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã xoá %1$@ trong %2$@: tệp nhập vào không được dùng bí mật đã lưu của bạn. Hãy tự thêm khoá bằng Lưu làm bí mật hoặc trong trình chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %2$@ 中的 %1$@：导入的文件不能使用你存储的密钥。请用“存储为密钥”或在编辑器中添加你自己的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除 %2$@ 中的 %1$@：匯入的檔案不能使用你儲存的密鑰。請用「儲存為密鑰」或在編輯器中加入你自己的密鑰。"
          }
        }
      }
    },
    "cloud.custom-uploader.warning.unsupported-body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Body-Typ „%@“ wird nicht unterstützt; stattdessen werden Multipart-Formulardaten verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body type “%@” isn’t supported; multipart form data is used instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de cuerpo «%@» no es compatible; se usará multipart form data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type de corps « %@ » n’est pas pris en charge ; multipart form data est utilisé à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוג הגוף ״%@״ אינו נתמך; ייעשה שימוש ב-multipart form data במקומו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の種類「%@」はサポートされていないため、マルチパートフォームデータを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 유형 “%@”은(는) 지원되지 않아 멀티파트 폼 데이터를 대신 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип тела «%@» не поддерживается; вместо него используется multipart form data."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại nội dung “%@” không được hỗ trợ; sẽ dùng multipart form data thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持正文类型“%@”，将改用 multipart 表单数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援本文類型「%@」，將改用 multipart 表單資料。"
          }
        }
      }
    },
