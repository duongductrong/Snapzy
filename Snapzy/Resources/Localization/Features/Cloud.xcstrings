    "cloud-settings.share-link-style-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Kurz“ blendet Dateiname und Aufnahmezeit im Link aus. Bestehende Links bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short hides the file name and capture time from the link. Existing links don't change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Corto» oculta el nombre del archivo y la hora de captura en el enlace. Los enlaces existentes no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Court » masque le nom du fichier et l'heure de capture dans le lien. Les liens existants ne changent pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״קצר״ מסתיר מהקישור את שם הקובץ ואת זמן הצילום. קישורים קיימים לא ישתנו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「短い」では、リンクにファイル名とキャプチャ日時が含まれません。既存のリンクは変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축형은 링크에서 파일 이름과 캡처 시간을 숨깁니다. 기존 링크는 바뀌지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Короткая» скрывает из ссылки имя файла и время снимка. Существующие ссылки не изменятся."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểu Ngắn ẩn tên tệp và thời gian chụp khỏi liên kết. Các liên kết hiện có không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“简短”会在链接中隐藏文件名和截图时间。现有链接不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「簡短」會在連結中隱藏檔案名稱和截圖時間。現有連結不會改變。"
          }
        }
      }
    },
