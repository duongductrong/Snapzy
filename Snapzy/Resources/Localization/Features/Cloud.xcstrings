    "cloud-operation.unsupported-file-type": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ akzeptiert nur Bilder. Videos können dort nicht hochgeladen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ only accepts images. Videos can't be uploaded there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ solo acepta imágenes. No se pueden subir videos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’accepte que les images. Les vidéos ne peuvent pas y être envoyées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "‏%@ מקבל רק תמונות. אי אפשר להעלות לשם סרטונים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は画像のみ対応しています。動画はアップロードできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미지만 지원합니다. 동영상은 업로드할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ принимает только изображения. Видео туда загрузить нельзя."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chỉ nhận hình ảnh. Không thể tải video lên đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
