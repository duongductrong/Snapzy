    "cloud.custom-uploader.warning.body-without-file": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Body-Typ „%@“ sendet nur Formularfelder, ohne die Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body type “%@” sends form fields only, without the file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tipo de cuerpo «%@» solo envía campos del formulario, sin el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le type de corps « %@ » envoie uniquement les champs du formulaire, sans le fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוג הגוף ״%@״ שולח רק שדות טופס, בלי הקובץ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文の種類「%@」はフォームフィールドのみを送信し、ファイルは送信しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본문 유형 “%@”은(는) 파일 없이 폼 필드만 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тип тела «%@» отправляет только поля формы, без файла."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại nội dung “%@” chỉ gửi các trường biểu mẫu, không gửi tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正文类型“%@”只发送表单字段，不发送文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本文類型「%@」只傳送表單欄位，不傳送檔案。"
          }
        }
      }
    },
