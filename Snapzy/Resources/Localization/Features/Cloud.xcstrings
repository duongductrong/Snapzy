    "cloud.custom-uploader.empty-state": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine eigenen Uploader. Lege einen an oder importiere eine ShareX-.sxcu-Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No custom uploaders yet. Create one or import a ShareX .sxcu file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay uploaders personalizados. Crea uno o importa un archivo .sxcu de ShareX."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun uploader personnalisé pour l’instant. Créez-en un ou importez un fichier ShareX .sxcu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין מעלים מותאמים. צרו אחד או ייבאו קובץ ShareX ‏.sxcu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタムアップローダーはまだありません。新規作成するか ShareX の .sxcu ファイルを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 사용자 지정 업로더가 없습니다. 새로 만들거나 ShareX .sxcu 파일을 가져오세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательских загрузчиков пока нет. Создайте новый или импортируйте файл ShareX .sxcu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có trình tải lên tùy chỉnh nào. Hãy tạo mới hoặc nhập tệp .sxcu của ShareX."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有自定义上传器。请新建一个或导入 ShareX .sxcu 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有自訂上傳器。請新增一個或匯入 ShareX .sxcu 檔案。"
          }
        }
      }
    },
