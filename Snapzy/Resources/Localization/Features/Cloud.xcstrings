          }
        }
      }
    },
    "cloud-settings.lifecycle-rule-info": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ihren Bucket wird eine Lebenszyklusregel konfiguriert, um Dateien nach dem ausgewählten Zeitraum automatisch zu löschen. Die Löschung kann bis zu 24 Stunden nach Ablauf dauern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A lifecycle rule will be configured on your bucket to auto-delete files after the selected period. Deletion may take up to 24 hours after expiration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se configurará una regla de ciclo de vida en su depósito para eliminar automáticamente archivos después del período seleccionado. La eliminación puede tardar hasta 24 horas después del vencimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de cycle de vie sera configurée sur votre compartiment pour supprimer automatiquement les fichiers après la période sélectionnée. La suppression peut prendre jusqu'à 24 heures après l'expiration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלל מחזור חיים יוגדר ב־Bucket כדי למחוק קבצים אוטומטית אחרי התקופה שנבחרה. המחיקה עשויה להימשך עד 24 שעות אחרי התפוגה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間の経過後にファイルを自動削除するように、バケットにライフサイクルルールが設定されます。削除には有効期限が切れてから最大 24 時間かかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간이 지나면 파일을 자동 삭제하도록 버킷에 수명 주기 규칙이 구성됩니다. 삭제는 만료 후 최대 24시간이 걸릴 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В вашем сегменте будет настроено правило жизненного цикла для автоматического удаления файлов по истечении выбранного периода. Удаление может занять до 24 часов после истечения срока действия."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một quy tắc lifecycle sẽ được cấu hình trên bucket của bạn để tự động xóa tệp sau khoảng thời gian đã chọn. Việc xóa có thể mất tới 24 giờ sau khi hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将在您的存储桶上配置生命周期规则，以在选定的时间段后自动删除文件。过期后最多可能需要 24 小时才能删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將在您的存儲桶上配置生命週期規則，以在選定的時間段後自動刪除檔案。過期後最多可能需要 24 小時才能刪除。"
          }
        }
      }
    },
    "cloud-settings.limited-permissions-warning": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit eingeschränkten Berechtigungen verbunden. Automatische Bereinigung (Lebenszyklusregeln) ist nicht verfügbar — Dateien bleiben erhalten, bis sie manuell gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected with limited permissions. Auto-cleanup (lifecycle rules) is unavailable — files will remain until manually deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado con permisos limitados. La limpieza automática (reglas de ciclo de vida) no está disponible; los archivos permanecerán hasta que se eliminen manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté avec des autorisations limitées. Le nettoyage automatique (règles de cycle de vie) n’est pas disponible : les fichiers resteront jusqu’à leur suppression manuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחובר עם הרשאות מוגבלות. ניקוי אוטומטי (כללי מחזור חיים) אינו זמין — הקבצים יישארו עד למחיקה ידנית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限が制限された状態で接続されています。自動クリーンアップ（ライフサイクルルール）は利用できないため、ファイルは手動で削除するまで残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한된 권한으로 연결되었습니다. 자동 정리(수명 주기 규칙)를 사용할 수 없으므로 파일은 수동으로 삭제할 때까지 남아 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключено с ограниченными правами. Автоочистка (правила жизненного цикла) недоступна — файлы останутся, пока вы не удалите их вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã kết nối với quyền hạn chế. Tự động dọn dẹp (quy tắc lifecycle) không khả dụng — tệp sẽ được giữ lại cho đến khi bạn tự xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用受限权限连接。自动清理（生命周期规则）不可用，文件将保留，直到手动删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用受限權限連接。自動清理（生命週期規則）不可用，檔案將保留，直到手動刪除。"
          }
        }
      }
    },
    "cloud-settings.no-lifecycle-rule-warning": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird keine Lebenszyklusregel festgelegt. Dateien bleiben dauerhaft erhalten, sofern sie nicht manuell gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No lifecycle rule will be set. Files will remain permanently unless manually deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se establecerá ninguna regla de ciclo de vida. Los archivos permanecerán permanentemente a menos que se eliminen manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune règle de cycle de vie ne sera définie. Les fichiers resteront définitivement à moins qu’ils ne soient supprimés manuellement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא יוגדר כלל מחזור חיים. הקבצים יישארו לצמיתות אלא אם יימחקו ידנית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライフサイクルルールは設定されません。ファイルは手動で削除しない限り永久に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수명 주기 규칙이 설정되지 않습니다. 수동으로 삭제하지 않는 한 파일은 영구적으로 유지됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакое правило жизненного цикла не будет установлено. Файлы останутся навсегда, если не будут удалены вручную."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không có quy tắc lifecycle nào được đặt. Tệp sẽ được giữ vĩnh viễn cho đến khi bạn tự xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会设置生命周期规则。除非手动删除，否则文件将永久保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會設置生命週期規則。除非手動刪除，否則檔案將永久保留。"
          }
        }
      }
    },
