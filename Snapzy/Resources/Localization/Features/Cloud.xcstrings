    "cloud.custom-uploader.editor.syntax-hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragefelder unterstützen {filename} und {secret:NAME}. Antwortvorlagen unterstützen {json:path}, {regex:pattern|group}, {response}, {header:name} und {filename}."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request fields support {filename} and {secret:NAME}. Response templates support {json:path}, {regex:pattern|group}, {response}, {header:name} and {filename}."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos de la solicitud admiten {filename} y {secret:NAME}. Las plantillas de respuesta admiten {json:path}, {regex:pattern|group}, {response}, {header:name} y {filename}."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs de requête acceptent {filename} et {secret:NAME}. Les modèles de réponse acceptent {json:path}, {regex:pattern|group}, {response}, {header:name} et {filename}."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שדות הבקשה תומכים ב-{filename} וב-{secret:NAME}. תבניות התגובה תומכות ב-{json:path}, ‏{regex:pattern|group}, ‏{response}, ‏{header:name} ו-{filename}."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストのフィールドでは {filename} と {secret:NAME} が使えます。レスポンスのテンプレートでは {json:path}、{regex:pattern|group}、{response}、{header:name}、{filename} が使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 필드는 {filename}과 {secret:NAME}을 지원합니다. 응답 템플릿은 {json:path}, {regex:pattern|group}, {response}, {header:name}, {filename}을 지원합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля запроса поддерживают {filename} и {secret:NAME}. Шаблоны ответа поддерживают {json:path}, {regex:pattern|group}, {response}, {header:name} и {filename}."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường yêu cầu hỗ trợ {filename} và {secret:NAME}. Mẫu phản hồi hỗ trợ {json:path}, {regex:pattern|group}, {response}, {header:name} và {filename}."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求字段支持 {filename} 和 {secret:NAME}。响应模板支持 {json:path}、{regex:pattern|group}、{response}、{header:name} 和 {filename}。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求欄位支援 {filename} 和 {secret:NAME}。回應範本支援 {json:path}、{regex:pattern|group}、{response}、{header:name} 和 {filename}。"
          }
        }
      }
    },
