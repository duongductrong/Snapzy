    "cloud.custom-uploader.section-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade auf deinen eigenen Server oder einen ShareX-kompatiblen Host hoch. Zugangsdaten werden als {secret:NAME} referenziert und im Schlüsselbund gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload to your own server or any ShareX-compatible host. Credentials are referenced as {secret:NAME} and kept in the Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube a tu propio servidor o a cualquier servicio compatible con ShareX. Las credenciales se referencian como {secret:NAME} y se guardan en el llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez vers votre propre serveur ou tout hébergeur compatible ShareX. Les identifiants sont référencés par {secret:NAME} et conservés dans le trousseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלו לשרת שלכם או לכל שירות תואם ShareX. אישורים מופנים כ-{secret:NAME} ונשמרים במחזיק המפתחות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のサーバーや ShareX 互換のサービスにアップロードします。認証情報は {secret:NAME} で参照され、キーチェーンに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 서버나 ShareX 호환 호스트에 업로드합니다. 자격 증명은 {secret:NAME}으로 참조되며 키체인에 보관됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка на ваш сервер или любой совместимый с ShareX хостинг. Учетные данные указываются как {secret:NAME} и хранятся в связке ключей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lên máy chủ của bạn hoặc bất kỳ dịch vụ nào tương thích ShareX. Thông tin xác thực được tham chiếu dưới dạng {secret:NAME} và lưu trong Chuỗi khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传到你自己的服务器或任何兼容 ShareX 的服务。凭据以 {secret:NAME} 引用，并保存在钥匙串中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳到你自己的伺服器或任何相容 ShareX 的服務。憑證以 {secret:NAME} 參照，並儲存在鑰匙圈中。"
          }
        }
      }
    },
