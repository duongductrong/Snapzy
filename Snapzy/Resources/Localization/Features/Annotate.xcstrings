    "annotate.ai.settings-consent-description": {
      "comment": "Settings › AI sending permissions description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy fragt einmal, bevor der erste Screenshot an einen Endpunkt oder eine Agent-CLI geht. Zurücksetzen, um erneut gefragt zu werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy asks once before the first screenshot goes to each endpoint or agent CLI. Reset to be asked again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy pregunta una vez antes de enviar la primera captura a cada endpoint o CLI de agente. Restablece para que vuelva a preguntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy demande une fois avant d’envoyer la première capture à chaque point de terminaison ou CLI d’agent. Réinitialisez pour être de nouveau sollicité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy שואל פעם אחת לפני שצילום המסך הראשון נשלח לכל נקודת קצה או CLI של סוכן. אפסו כדי להישאל שוב."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy は各エンドポイントやエージェント CLI に最初のスクリーンショットを送る前に一度だけ確認します。リセットすると再度確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy는 각 엔드포인트나 에이전트 CLI로 첫 스크린샷을 보내기 전에 한 번 묻습니다. 재설정하면 다시 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy спрашивает один раз перед отправкой первого снимка каждому эндпоинту или CLI-агенту. Сбросьте, чтобы спросить снова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy hỏi một lần trước khi gửi ảnh chụp đầu tiên tới mỗi endpoint hoặc agent CLI. Đặt lại để được hỏi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 会在首次把截图发送给每个端点或代理 CLI 前询问一次。重置后会再次询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 會在首次把截圖傳送給每個端點或代理 CLI 前詢問一次。重設後會再次詢問。"
          }
        }
      }
    },
