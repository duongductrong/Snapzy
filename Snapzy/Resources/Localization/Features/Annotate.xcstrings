    "annotate.ai.settings-cli-footer": {
      "comment": "Settings › AI agent CLI section footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy führt die CLI im Hintergrund aus und gibt ihr nur die Anmerkungswerkzeuge von Snapzy. Anmeldung, Modell und Nutzung gehören zur CLI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy runs the CLI in the background and gives it only Snapzy’s annotation tools. Sign-in, model and usage belong to the CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy ejecuta la CLI en segundo plano y solo le da las herramientas de anotación de Snapzy. El inicio de sesión, el modelo y el uso dependen de la CLI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy exécute la CLI en arrière-plan et ne lui donne que les outils d’annotation de Snapzy. La connexion, le modèle et l’usage relèvent de la CLI."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy מריץ את ה‑CLI ברקע ונותן לו רק את כלי ההערות של Snapzy. ההתחברות, המודל והשימוש שייכים ל‑CLI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy は CLI をバックグラウンドで実行し、Snapzy の注釈ツールだけを渡します。サインイン、モデル、利用量は CLI 側の管理です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy는 CLI를 백그라운드에서 실행하고 Snapzy의 주석 도구만 제공합니다. 로그인, 모델, 사용량은 CLI에서 관리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy запускает CLI в фоне и даёт ей только инструменты аннотаций Snapzy. Вход, модель и расход относятся к самой CLI."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy chạy CLI ở chế độ nền và chỉ cấp cho nó các công cụ chú thích của Snapzy. Đăng nhập, mô hình và hạn mức thuộc về CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 在后台运行 CLI，只向它提供 Snapzy 的标注工具。登录、模型和用量均由 CLI 自行管理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 在背景執行 CLI，只提供 Snapzy 的標註工具給它。登入、模型與用量皆由 CLI 自行管理。"
          }
        }
      }
    },
