    "annotate.ai.consent-message": {
      "comment": "Alert message before the first AI prompt goes to an off-device provider. %@ is the server host",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Antwort werden der Screenshot und der darin erkannte Text an %@ gesendet. Snapzy fragt einmal pro Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To answer, the screenshot and the text recognized in it are sent to %@. Snapzy asks once for each provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para responder, la captura y el texto reconocido en ella se envían a %@. Snapzy lo pregunta una vez por proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour répondre, la capture et le texte qui y est reconnu sont envoyés à %@. Snapzy ne le demande qu’une fois par fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי לענות, צילום המסך והטקסט שזוהה בו נשלחים אל %@. ‏Snapzy שואלת פעם אחת לכל ספק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答のため、スクリーンショットと認識されたテキストが%@に送信されます。確認はプロバイダごとに1回だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변하기 위해 스크린샷과 그 안에서 인식된 텍스트가 %@(으)로 전송됩니다. Snapzy는 제공자마다 한 번만 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для ответа снимок экрана и распознанный на нём текст отправляются на %@. Snapzy спрашивает один раз для каждого провайдера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trả lời, ảnh chụp màn hình và chữ nhận diện được trong ảnh sẽ được gửi tới %@. Snapzy chỉ hỏi một lần cho mỗi nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了回答，截图及其中识别出的文字会发送到 %@。Snapzy 对每个提供方只询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了回答，截圖及其中辨識出的文字會傳送到 %@。Snapzy 對每個提供者只詢問一次。"
          }
        }
      }
    },
