    "annotate.ai.settings-hero-subtitle": {
      "comment": "Settings › AI page subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, wer in Annotate auf „Fragen“ antwortet: Apple Intelligence auf diesem Mac, dein eigener Endpunkt oder eine Agent-CLI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose who answers Ask in Annotate: Apple Intelligence on this Mac, your own endpoint, or an agent CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige quién responde a Preguntar en Anotar: Apple Intelligence en este Mac, tu propio endpoint o una CLI de agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez qui répond à Demander dans Annoter : Apple Intelligence sur ce Mac, votre propre point de terminaison ou une CLI d’agent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו מי עונה ל„שאל” בהערות: Apple Intelligence במק הזה, נקודת קצה משלכם או CLI של סוכן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注釈の「質問」に応答するものを選択します：この Mac の Apple Intelligence、独自のエンドポイント、またはエージェント CLI。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주석의 질문에 답할 대상을 선택하세요: 이 Mac의 Apple Intelligence, 직접 설정한 엔드포인트 또는 에이전트 CLI."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, кто отвечает на «Спросить» в аннотациях: Apple Intelligence на этом Mac, ваш эндпоинт или CLI-агент."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ai trả lời Hỏi AI trong Annotate: Apple Intelligence trên máy này, endpoint của bạn hoặc agent CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择由谁回答标注中的“提问”：本机上的 Apple Intelligence、你自己的端点，或代理 CLI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇由誰回答標註中的「提問」：本機上的 Apple Intelligence、你自己的端點，或代理 CLI。"
          }
        }
      }
    },
