    "annotate.ai.settings-provider-description": {
      "comment": "Settings › AI provider row description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch nutzt Apple Intelligence, sobald es bereit ist. Endpunkte und Agent-CLIs werden nie automatisch gewählt, da sie den Screenshot an andere Stellen senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic uses Apple Intelligence when it’s ready. Endpoints and agent CLIs are never picked for you, since they send the screenshot off this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático usa Apple Intelligence cuando está lista. Los endpoints y las CLI de agente nunca se eligen solos, porque envían la captura fuera de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatique utilise Apple Intelligence dès qu’elle est prête. Les points de terminaison et les CLI d’agent ne sont jamais choisis à votre place, car ils envoient la capture hors de ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוטומטי משתמש ב‑Apple Intelligence כשהיא מוכנה. נקודות קצה ו‑CLI של סוכנים לעולם אינם נבחרים עבורכם, כי הם שולחים את צילום המסך אל מחוץ למק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動では、準備ができていれば Apple Intelligence を使います。エンドポイントやエージェント CLI はスクリーンショットを Mac の外へ送るため、自動では選ばれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 Apple Intelligence가 준비되면 사용합니다. 엔드포인트와 에이전트 CLI는 스크린샷을 이 Mac 밖으로 보내므로 자동으로 선택되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Автоматически» использует Apple Intelligence, когда она готова. Эндпоинты и CLI-агенты никогда не выбираются сами, потому что отправляют снимок за пределы Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động dùng Apple Intelligence khi sẵn sàng. Endpoint và agent CLI không bao giờ được chọn tự động vì chúng gửi ảnh chụp ra khỏi máy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“自动”会在 Apple Intelligence 就绪时使用它。端点和代理 CLI 会把截图发送到本机之外，因此不会被自动选用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」會在 Apple Intelligence 就緒時使用它。端點和代理 CLI 會把截圖傳送到本機之外，因此不會被自動選用。"
          }
        }
      }
    },
