    "annotate.highlighter-text-snapping-description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte Markierungen beim Ziehen an nahegelegenen Textzeilen aus. ⌘ gedrückt halten, um es vorübergehend zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Align highlighter strokes to nearby text lines while dragging. Hold ⌘ to temporarily disable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alinea los trazos del resaltador con las líneas de texto cercanas al arrastrar. Mantén ⌘ para desactivarlo temporalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligne les tracés du surligneur sur les lignes de texte proches pendant le glissement. Maintenez ⌘ pour désactiver temporairement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יישור קווי המרקר לשורות טקסט סמוכות בזמן הגרירה. החזק ⌘ כדי להשבית זמנית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にハイライトを近くのテキスト行に合わせます。⌘ を押している間は一時的に無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 형광펜을 근처 텍스트 줄에 맞춥니다. ⌘를 누르면 일시적으로 비활성화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выравнивает выделение по ближайшим строкам текста при перетаскивании. Удерживайте ⌘, чтобы временно отключить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Căn nét tô sáng theo dòng văn bản gần nhất khi kéo. Giữ ⌘ để tạm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时将高亮对齐到附近的文字行。按住 ⌘ 可临时停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳時將螢光標示對齊附近的文字行。按住 ⌘ 可暫時停用。"
          }
        }
      }
    },
    "annotate.jpeg-removes-transparency-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Bild verwendet einen transparenten Hintergrundausschnitt. Beim Speichern als JPEG wird die Transparenz auf einen undurchsichtigen Hintergrund reduziert. Verwenden Sie PNG oder WebP, um die Transparenz aufrechtzuerhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This image uses a transparent background cutout. Saving as JPEG will flatten transparency to an opaque background. Use PNG or WebP to keep transparency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen utiliza un recorte de fondo transparente. Guardar como JPEG aplanará la transparencia a un fondo opaco. Utilice PNG o WebP para mantener la transparencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image utilise une découpe d'arrière-plan transparente. L'enregistrement au format JPEG aplatira la transparence sur un arrière-plan opaque. Utilisez PNG ou WebP pour conserver la transparence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לתמונה זו יש רקע שקוף. שמירה כ־JPEG תהפוך את השקיפות לרקע אטום. השתמש ב־PNG או WebP כדי לשמור על השקיפות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画像は透明な背景の切り抜きを使用しています。 JPEG として保存すると、透明度が不透明な背景に平坦化されます。透明性を維持するには、PNG または WebP を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이미지는 투명한 배경 컷아웃을 사용합니다. JPEG로 저장하면 투명도가 불투명한 배경으로 병합됩니다. 투명성을 유지하려면 PNG 또는 WebP를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом изображении используется вырез на прозрачном фоне. Сохранение в формате JPEG приведет к выравниванию прозрачности до непрозрачного фона. Используйте PNG или WebP, чтобы сохранить прозрачность."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh này đang dùng nền trong suốt sau khi tách nền. Lưu dưới dạng JPEG sẽ làm phẳng nền trong suốt thành nền đục. Hãy dùng PNG hoặc WebP để giữ nền trong suốt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此图片已移除背景并保留透明区域。保存为 JPEG 会把透明区域填充为不透明背景。请使用 PNG 或 WebP 保留透明背景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此圖片已移除背景並保留透明區域。儲存為 JPEG 會將透明區域填滿為不透明背景。請使用 PNG 或 WebP 保留透明背景。"
          }
        }
      }
    },
