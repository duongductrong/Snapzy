    "annotate.ai.settings-cli-effort-description": {
      "comment": "Settings › AI agent CLI reasoning effort description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher effort handles complex edits better, but replies slower."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Aufwand bewältigt komplexe Bearbeitungen besser, antwortet aber langsamer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más esfuerzo resuelve mejor las ediciones complejas, pero responde más despacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un effort plus élevé gère mieux les modifications complexes, mais répond plus lentement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאמץ גבוה יותר מטפל טוב יותר בעריכות מורכבות, אבל עונה לאט יותר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "度合いを上げると複雑な編集に強くなりますが、応答は遅くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "강도가 높을수록 복잡한 편집을 잘 처리하지만 응답이 느려집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более глубокие рассуждения лучше справляются со сложными правками, но отвечают медленнее."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mức cao xử lý chỉnh sửa phức tạp tốt hơn nhưng trả lời chậm hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强度越高越能处理复杂编辑，但回复更慢。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "強度越高越能處理複雜編輯，但回覆較慢。"
          }
        }
      }
    },
