    "annotate.translate.layout-note": {
      "comment": "Settings note explaining how Annotate Auto Translate uses the translation settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto Translate in Annotate (⌘⇧T) uses these settings. It always finds text positions on this Mac, even when OCR uses a custom endpoint."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch übersetzen in Annotate (⌘⇧T) verwendet diese Einstellungen. Textpositionen werden immer auf diesem Mac ermittelt, auch wenn OCR einen eigenen Endpunkt nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traducir automáticamente en Anotar (⌘⇧T) usa estos ajustes. Siempre localiza el texto en este Mac, aunque el OCR use un endpoint propio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction automatique d’Annoter (⌘⇧T) utilise ces réglages. Elle repère toujours le texte sur ce Mac, même si l’OCR utilise un point de terminaison personnalisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תרגום אוטומטי בעריכה (⌘⇧T) משתמש בהגדרות אלה. מיקומי הטקסט מזוהים תמיד במחשב Mac זה, גם כש‑OCR משתמש בנקודת קצה מותאמת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注釈の自動翻訳(⌘⇧T)はこの設定を使います。OCRがカスタムエンドポイントを使う場合でも、テキストの位置は常にこのMac上で検出します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주석의 자동 번역(⌘⇧T)은 이 설정을 사용합니다. OCR이 사용자 지정 엔드포인트를 쓰더라도 텍스트 위치는 항상 이 Mac에서 찾습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоперевод в редакторе (⌘⇧T) использует эти настройки. Положение текста всегда определяется на этом Mac, даже если OCR использует свой endpoint."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động dịch trong Annotate (⌘⇧T) dùng các cài đặt này. Vị trí chữ luôn được nhận diện ngay trên máy Mac, kể cả khi OCR dùng endpoint riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标注中的自动翻译(⌘⇧T)使用这些设置。即使 OCR 使用自定义端点,文字位置也始终在此 Mac 上识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標註中的自動翻譯(⌘⇧T)使用這些設定。即使 OCR 使用自訂端點,文字位置也一律在此 Mac 上辨識。"
          }
        }
      }
    },
