        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много для обработки на устройстве. Сократите запрос"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá dài để xử lý trên máy. Hãy thử yêu cầu ngắn hơn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内容过多，无法在设备上处理。请尝试更短的请求"
