    "annotate.ai.consent-title": {
      "comment": "Alert title before the first AI prompt goes to an off-device provider. %@ is the provider name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Screenshot an %@ senden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this screenshot to %@?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Enviar esta captura a %@?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer cette capture à %@ ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשלוח את צילום המסך הזה אל %@?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスクリーンショットを%@に送信しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스크린샷을 %@(으)로 보낼까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправить этот снимок экрана в %@?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi ảnh chụp màn hình này tới %@?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此截图发送到 %@？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要將此截圖傳送到 %@ 嗎？"
          }
        }
      }
    },
    "annotate.ai.invalid-reply": {
      "comment": "A custom AI endpoint answered with something Snapzy can't use",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort des Modells konnte nicht gelesen werden. Versuche es erneut oder wähle ein anderes Modell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model’s answer couldn’t be read. Try again or choose another model"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer la respuesta del modelo. Inténtalo de nuevo o elige otro modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire la réponse du modèle. Réessayez ou choisissez un autre modèle"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את תשובת המודל. נסו שוב או בחרו מודל אחר"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルの応答を読み取れませんでした。もう一度試すか、別のモデルを選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델의 응답을 읽을 수 없습니다. 다시 시도하거나 다른 모델을 선택하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать ответ модели. Повторите попытку или выберите другую модель"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được câu trả lời của mô hình. Thử lại hoặc chọn mô hình khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取模型的回答。请重试或选择其他模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取模型的回答。請重試或選擇其他模型"
          }
        }
      }
    },
