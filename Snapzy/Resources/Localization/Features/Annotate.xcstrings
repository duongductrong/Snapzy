    "annotate.ai.settings-endpoints-footer": {
      "comment": "Settings › AI endpoints section footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-kompatible Endpunkte, gemeinsam genutzt mit OCR und Übersetzen. „Testen“ prüft, ob das Modell Werkzeuge aufrufen und Bilder lesen kann; Snapzy lernt das auch bei der Nutzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-compatible endpoints, shared with OCR and Translate. Test checks whether the model can call tools and read images; Snapzy also learns this while you use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoints compatibles con OpenAI, compartidos con OCR y Traducir. Probar comprueba si el modelo puede usar herramientas y leer imágenes; Snapzy también lo aprende mientras lo usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points de terminaison compatibles OpenAI, partagés avec l’OCR et la traduction. Tester vérifie si le modèle peut appeler des outils et lire des images ; Snapzy l’apprend aussi à l’usage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודות קצה תואמות OpenAI, משותפות עם OCR ותרגום. „בדיקה” בודקת אם המודל יכול לקרוא לכלים ולקרוא תמונות; Snapzy לומד זאת גם תוך כדי שימוש."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR と翻訳で共有される OpenAI 互換エンドポイントです。「テスト」でモデルがツール呼び出しと画像の読み取りに対応しているか確認します。使用中にも Snapzy が自動で学習します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OCR 및 번역과 공유하는 OpenAI 호환 엔드포인트입니다. 테스트는 모델이 도구를 호출하고 이미지를 읽을 수 있는지 확인합니다. 사용하는 동안에도 Snapzy가 이를 파악합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenAI-совместимые эндпоинты, общие с OCR и переводом. «Проверить» выясняет, умеет ли модель вызывать инструменты и читать изображения; Snapzy также узнаёт это в процессе работы."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint tương thích OpenAI, dùng chung với OCR và Dịch. Kiểm tra xem mô hình có gọi được công cụ và đọc được ảnh không; Snapzy cũng tự học điều này khi bạn dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 OCR 和翻译共用的 OpenAI 兼容端点。“测试”会检查模型能否调用工具和读取图像；使用过程中 Snapzy 也会自动了解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 OCR 和翻譯共用的 OpenAI 相容端點。「測試」會檢查模型能否呼叫工具和讀取影像；使用過程中 Snapzy 也會自動了解。"
          }
        }
      }
    },
