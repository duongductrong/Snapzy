    "annotate.ai.settings-send-image-description": {
      "comment": "Settings › AI send image description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpunkte und Agent-CLIs erhalten den Screenshot zusammen mit dem erkannten Text. Wenn aus, werden nur der Text und sein Layout gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoints and agent CLIs get the screenshot along with the recognized text. When off, only the text and its layout are sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los endpoints y las CLI de agente reciben la captura junto con el texto reconocido. Si está desactivado, solo se envían el texto y su disposición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points de terminaison et les CLI d’agent reçoivent la capture avec le texte reconnu. Désactivé, seuls le texte et sa mise en page sont envoyés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודות קצה ו‑CLI של סוכנים מקבלים את צילום המסך יחד עם הטקסט שזוהה. כשהאפשרות כבויה, נשלחים רק הטקסט והפריסה שלו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントとエージェント CLI には、認識されたテキストと一緒にスクリーンショットが送られます。オフにすると、テキストとそのレイアウトだけが送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트와 에이전트 CLI는 인식된 텍스트와 함께 스크린샷을 받습니다. 끄면 텍스트와 그 배치만 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эндпоинты и CLI-агенты получают снимок вместе с распознанным текстом. Если выключено, отправляются только текст и его расположение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoint và agent CLI nhận ảnh chụp cùng với chữ nhận diện được. Khi tắt, chỉ gửi chữ và bố cục của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点和代理 CLI 会收到截图及识别出的文字。关闭后，只发送文字及其布局。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端點和代理 CLI 會收到截圖及辨識出的文字。關閉後，只傳送文字及其版面。"
          }
        }
      }
    },
