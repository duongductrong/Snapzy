    "annotate.ai.consent-message-cli": {
      "comment": "Alert message before the first AI prompt goes to an agent CLI. %@ is the CLI name (Claude Code, Codex, OpenCode)",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ erhält den Screenshot und den darin erkannten Text und sendet beides an seinen Modellanbieter. Dabei können auch deine eigenen MCP-Server, Hooks und Anweisungen geladen werden. Snapzy fragt einmal pro Anbieter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gets the screenshot and the text recognized in it, and sends them to its model provider. It may also load your own MCP servers, hooks and instructions. Snapzy asks once for each provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recibe la captura y el texto reconocido en ella, y los envía a su proveedor de modelos. También puede cargar tus propios servidores MCP, hooks e instrucciones. Snapzy pregunta una vez por proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reçoit la capture et le texte qui y est reconnu, puis les envoie à son fournisseur de modèle. Il peut aussi charger vos propres serveurs MCP, hooks et instructions. Snapzy demande une seule fois par fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ מקבל את צילום המסך ואת הטקסט שזוהה בו, ושולח אותם לספק המודל שלו. ייתכן שיטען גם שרתי MCP, hooks והוראות משלך. Snapzy שואל פעם אחת לכל ספק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はスクリーンショットと認識されたテキストを受け取り、自身のモデルプロバイダへ送信します。ユーザー独自の MCP サーバ、フック、指示も読み込まれる場合があります。Snapzy はプロバイダごとに一度だけ確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 스크린샷과 인식된 텍스트를 받아 자체 모델 제공자에게 보냅니다. 사용자의 MCP 서버, 훅, 지침도 함께 불러올 수 있습니다. Snapzy는 제공자마다 한 번만 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ получит снимок и распознанный на нём текст и отправит их своему поставщику модели. Он также может загрузить ваши MCP-серверы, хуки и инструкции. Snapzy спрашивает один раз для каждого поставщика."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sẽ nhận ảnh chụp và chữ nhận diện được, rồi gửi tới nhà cung cấp mô hình của nó. Nó cũng có thể nạp MCP server, hook và chỉ dẫn riêng của bạn. Snapzy chỉ hỏi một lần cho mỗi nhà cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会收到截图及其中识别出的文字，并发送给它的模型提供方。它还可能加载你自己的 MCP 服务器、钩子和指令。Snapzy 对每个提供方只询问一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 會收到截圖及其中辨識出的文字，並傳送給它的模型供應商。它也可能載入你自己的 MCP 伺服器、掛鉤與指示。Snapzy 對每個供應商只詢問一次。"
          }
        }
      }
    },
