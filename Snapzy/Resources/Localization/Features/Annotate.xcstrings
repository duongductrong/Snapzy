    "annotate.ai.apple-too-long": {
      "comment": "The prompt plus screenshot did not fit the on-device model's context",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viel für das Gerät. Versuche eine kürzere Anfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too much to handle on-device. Try a shorter request"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado para procesar en el dispositivo. Prueba una solicitud más corta"
