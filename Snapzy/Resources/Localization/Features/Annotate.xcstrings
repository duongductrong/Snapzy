    "annotate.crop-snap-to-edges-description": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richtet die Zuschneidekanten beim Ziehen an Inhaltskanten aus. ⌘ gedrückt halten, um dies vorübergehend zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snap crop edges to content borders while dragging. Hold ⌘ to temporarily disable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta los bordes del recorte a los bordes del contenido al arrastrar. Mantén ⌘ para desactivarlo temporalmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aligne les bords du recadrage sur les bords du contenu pendant le glissement. Maintenez ⌘ pour désactiver temporairement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצמדת קצוות החיתוך לגבולות התוכן בזמן הגרירה. החזק ⌘ כדי להשבית זמנית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグ中にクロップ枠をコンテンツの境界にスナップします。⌘を押している間は一時的に無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드래그하는 동안 자르기 가장자리를 콘텐츠 경계에 맞춥니다. ⌘를 누르고 있으면 일시적으로 비활성화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязывать края области обрезки к границам содержимого при перетаскивании. Удерживайте ⌘ для временного отключения."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Căn cạnh cắt theo đường viền nội dung khi kéo. Giữ ⌘ để tạm tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动时将裁剪边缘吸附到内容边界。按住 ⌘ 可暂时停用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖曳時將裁剪邊緣吸附到內容邊界。按住 ⌘ 可暫時停用。"
          }
        }
      }
    },
