    "annotate.ai.settings-cli-model-picker-description": {
      "comment": "Settings › AI agent CLI model picker description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models this CLI can use. CLI default follows its own settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle, die diese CLI nutzen kann. „CLI-Standard“ folgt ihren eigenen Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelos que puede usar esta CLI. «Predeterminado de la CLI» sigue su propia configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèles utilisables par cette CLI. « Par défaut de la CLI » suit ses propres réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודלים שה-CLI הזה יכול להשתמש בהם. ברירת המחדל של ה-CLI פועלת לפי ההגדרות שלו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このCLIで使えるモデルです。「CLIのデフォルト」はCLI自身の設定に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 CLI에서 쓸 수 있는 모델입니다. CLI 기본값은 CLI 자체 설정을 따릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели, доступные этому CLI. «По умолчанию CLI» следует его собственным настройкам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mô hình CLI này dùng được. Mặc định của CLI sẽ theo cài đặt riêng của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CLI 可用的模型。“CLI 默认”遵循其自身设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CLI 可用的模型。「CLI 預設」依循其自身設定。"
          }
        }
      }
    },
    "annotate.ai.settings-cli-location-description": {
