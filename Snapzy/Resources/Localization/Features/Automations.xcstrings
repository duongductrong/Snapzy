    "automations.template.text-footer": {
      "comment": "Footer of the Copy text template field; keep tokens in braces unchanged",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} ist der erkannte oder übersetzte Text. Verwende {saved.relativePath} nach „In Ordner sichern“ für Markdown-Bildlinks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} is the recognized or translated text. Use {saved.relativePath} after Save to folder for Markdown image links."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} es el texto reconocido o traducido. Usa {saved.relativePath} después de Guardar en carpeta para enlaces de imagen en Markdown."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} est le texte reconnu ou traduit. Utilisez {saved.relativePath} après Enregistrer dans un dossier pour les liens d’image Markdown."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} הוא הטקסט שזוהה או תורגם. השתמשו ב-{saved.relativePath} אחרי שמירה בתיקייה עבור קישורי תמונה ב-Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} は認識または翻訳したテキストです。Markdown の画像リンクには「フォルダに保存」の後で {saved.relativePath} を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{text}는 인식되거나 번역된 텍스트입니다. Markdown 이미지 링크에는 폴더에 저장 다음에 {saved.relativePath}를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} — распознанный или переведённый текст. Для ссылок на изображения в Markdown используйте {saved.relativePath} после шага «Сохранить в папку»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} là văn bản đã nhận dạng hoặc đã dịch. Dùng {saved.relativePath} sau bước Lưu vào thư mục để tạo liên kết ảnh Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} 是识别或翻译后的文本。在“保存到文件夹”之后使用 {saved.relativePath} 可生成 Markdown 图像链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} 是辨識或翻譯後的文字。在「儲存到檔案夾」之後使用 {saved.relativePath} 可產生 Markdown 影像連結。"
          }
        }
      }
    },
