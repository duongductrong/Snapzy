          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳がタイムアウトしました。システム設定 → 一般 → 言語と地域 → 翻訳言語 で言語をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역 시간이 초과되었습니다. 시스템 설정 → 일반 → 언어 및 지역 → 번역 언어에서 언어를 다운로드하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время перевода истекло. Загрузите язык в «Системные настройки → Основные → Язык и регион → Языки перевода»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hết thời gian dịch. Hãy tải ngôn ngữ trong Cài đặt hệ thống → Cài đặt chung → Ngôn ngữ & Vùng → Ngôn ngữ dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译超时。请在“系统设置 → 通用 → 语言与地区 → 翻译语言”中下载该语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯逾時。請在「系統設定 → 一般 → 語言與地區 → 翻譯語言」中下載該語言。"
          }
        }
      }
    },
