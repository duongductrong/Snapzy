    "automations.editor.save-blocked-help": {
      "comment": "Tooltip on the disabled Save button",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt hat nichts zu verarbeiten. Behebe die markierten Schritte, um zu sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A step has nothing to work on. Fix the marked steps to save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paso no tiene nada con qué trabajar. Corrige los pasos marcados para guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape n’a rien à traiter. Corrigez les étapes signalées pour enregistrer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשלב אחד אין על מה לעבוד. תקנו את השלבים המסומנים כדי לשמור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "処理対象のないステップがあります。保存するには、マークされたステップを修正してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처리할 대상이 없는 단계가 있습니다. 저장하려면 표시된 단계를 수정하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одному из шагов нечего обрабатывать. Исправьте отмеченные шаги, чтобы сохранить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có bước không có gì để xử lý. Hãy sửa các bước được đánh dấu để lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有步骤没有可处理的内容。请修正标记的步骤后再保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有步驟沒有可處理的內容。請修正標示的步驟後再儲存。"
          }
        }
      }
    },
