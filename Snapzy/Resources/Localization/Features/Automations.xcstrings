    },
    "automations.external.description": {
      "comment": "Automation editor: risk explanation under the external invocation toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Apps und Skripte können diese Automation starten, einschließlich Bildschirmaufnahme und Upload. Nur für Automationen aktivieren, die du so starten möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other apps and scripts can start this automation, including capturing your screen and uploading. Turn this on only for automations you want to start that way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otras apps y scripts podrán iniciar esta automatización, incluida la captura de pantalla y la subida. Actívalo solo en las automatizaciones que quieras iniciar así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres apps et scripts pourront lancer cette automatisation, y compris capturer l’écran et téléverser. N’activez cette option que pour les automatisations à lancer ainsi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפליקציות וסקריפטים אחרים יוכלו להפעיל את האוטומציה, כולל צילום המסך והעלאה. הפעילו רק לאוטומציות שתרצו להפעיל כך."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリやスクリプトから、画面のキャプチャやアップロードを含めてこのオートメーションを開始できます。そのように使うオートメーションだけでオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱과 스크립트가 화면 캡처와 업로드를 포함해 이 자동화를 시작할 수 있습니다. 그렇게 시작할 자동화에서만 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другие приложения и скрипты смогут запускать эту автоматизацию, включая снимок экрана и загрузку. Включайте только для тех автоматизаций, которые нужно запускать так."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng và script khác có thể khởi chạy tự động hóa này, kể cả chụp màn hình và tải lên. Chỉ bật cho những tự động hóa bạn muốn khởi chạy theo cách đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 和脚本可以启动此自动化，包括截取屏幕和上传。仅对需要这样启动的自动化开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 和指令碼可以啟動此自動化，包括擷取螢幕和上傳。僅對需要這樣啟動的自動化開啟。"
          }
        }
      }
    },
