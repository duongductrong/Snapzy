    "automations.describe.stop": {
      "comment": "Inspector description of the Stop step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet den Lauf hier erfolgreich. In einer von einer anderen Automation gestarteten Automation geht es dort weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the run here, successfully. In an automation run by another one, returns to it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina la ejecución aquí correctamente. En una automatización ejecutada por otra, vuelve a ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine l’exécution ici, avec succès. Dans une automatisation lancée par une autre, revient à celle-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיים את ההרצה כאן בהצלחה. באוטומציה שהופעלה על ידי אחרת, חוזר אליה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで実行を正常に終了します。別のオートメーションから実行された場合は、そちらに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 실행을 정상 종료합니다. 다른 자동화가 실행한 경우 그 자동화로 돌아갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Успешно завершает запуск здесь. Если автоматизацию запустила другая, возвращает управление ей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết thúc lần chạy tại đây (thành công). Nếu được tự động hoá khác gọi, sẽ quay lại tự động hoá đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此成功结束运行。若由其他自动化调用，则返回该自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此成功結束執行。若由其他自動化呼叫，則返回該自動化。"
          }
        }
      }
    },
    "automations.describe.strip-metadata": {
      "comment": "Inspector description of the Remove metadata step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
