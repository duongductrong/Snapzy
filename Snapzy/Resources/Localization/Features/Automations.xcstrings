{
  "sourceLanguage": "en",
  "strings": {
    "automations.cloud-warning": {
      "comment": "Warning on automations that upload while cloud upload is not set up",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud-Upload ist nicht eingerichtet, daher wird stattdessen das Bild kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud upload isn’t set up, so this copies the image instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida a la nube no está configurada, así que se copia la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement cloud n’est pas configuré : l’image est copiée à la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העלאה לענן לא הוגדרה, ולכן התמונה תועתק במקום זאת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドアップロードが未設定のため、代わりに画像をコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라우드 업로드가 설정되지 않아 대신 이미지를 복사합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка в облако не настроена, поэтому копируется изображение."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa cấu hình Cloud nên automation này sẽ copy ảnh thay vì link."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未设置云上传，因此会改为复制图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未設定雲端上傳，因此會改為拷貝影像。"
          }
        }
      }
    },
