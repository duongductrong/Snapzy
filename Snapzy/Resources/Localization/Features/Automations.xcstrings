    "automations.activity.description": {
      "comment": "Activity section description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten 100 Durchläufe mit Schrittdauern. Es werden keine Bilder gespeichert; Text wird gekürzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last 100 runs with step timings. No images are stored; text is shortened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas 100 ejecuciones con la duración de cada paso. No se guardan imágenes; el texto se acorta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les 100 dernières exécutions avec la durée de chaque étape. Aucune image n’est stockée ; le texte est raccourci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "100 ההרצות האחרונות עם משך כל שלב. לא נשמרות תמונות; הטקסט מקוצר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近 100 回の実行とステップごとの所要時間です。画像は保存されず、テキストは短縮されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계별 소요 시간이 포함된 최근 100회 실행입니다. 이미지는 저장되지 않으며 텍스트는 줄여서 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние 100 запусков с длительностью шагов. Изображения не сохраняются, текст сокращается."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "100 lượt chạy gần nhất kèm thời gian từng bước. Không lưu ảnh; văn bản được rút gọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 100 次运行及各步骤耗时。不保存图像；文本会被缩短。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 100 次執行及各步驟耗時。不儲存影像；文字會被縮短。"
          }
        }
      }
    },
