    "automations.inspector.webhook.footer": {
      "comment": "Webhook inspector footer; {secret:NAME} is syntax, keep it",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In einem JSON-Body werden Werte JSON-maskiert. Lege Tokens als Secret ab und schreibe {secret:NAME}, damit sie nicht in deiner Konfigurationsdatei landen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are JSON-escaped in a JSON body. Put tokens in a secret and write {secret:NAME} so they stay out of your config file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En un cuerpo JSON los valores se escapan como JSON. Guarda los tokens en un secreto y escribe {secret:NAME} para que no queden en tu archivo de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans un corps JSON, les valeurs sont échappées en JSON. Mettez les jetons dans un secret et écrivez {secret:NAME} pour qu’ils restent hors de votre fichier de configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בגוף JSON הערכים עוברים escape של JSON. כדאי לשמור טוקנים כסוד ולכתוב {secret:NAME} כדי שלא יופיעו בקובץ התצורה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 本文の値は JSON としてエスケープされます。トークンはシークレットに保存し {secret:NAME} と書くと、設定ファイルに残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 본문의 값은 JSON으로 이스케이프됩니다. 토큰은 비밀 값에 저장하고 {secret:NAME}으로 쓰면 설정 파일에 남지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В JSON-теле значения экранируются. Храните токены в секретах и пишите {secret:NAME}, чтобы они не попали в файл конфигурации."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong nội dung JSON, giá trị được escape theo JSON. Hãy lưu token vào bí mật và viết {secret:NAME} để token không nằm trong tệp cấu hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 正文中的值会按 JSON 转义。把令牌存为密钥并写成 {secret:NAME}，就不会出现在配置文件里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 內文中的值會依 JSON 跳脫。把權杖存為密鑰並寫成 {secret:NAME}，就不會出現在設定檔裡。"
          }
        }
      }
    },
