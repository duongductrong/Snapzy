        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 다른 앱에서 실행할 수 없습니다. 설정 → 자동화에서 허용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту автоматизацию нельзя запускать из других приложений. Разрешите это в «Настройки → Автоматизации»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chạy tự động hóa này từ ứng dụng khác. Cho phép trong Cài đặt → Tự động hóa."
