    "automations.delete-confirm-message": {
      "comment": "Delete confirmation message",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Automation und ihr Kurzbefehl werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automation and its shortcut will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán la automatización y su atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’automatisation et son raccourci seront supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האוטומציה וקיצור הדרך שלה יוסרו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションとそのショートカットが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화와 단축키가 삭제됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизация и её сочетание клавиш будут удалены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation và phím tắt của nó sẽ bị xoá."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除该自动化及其快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將刪除此自動化及其快速鍵。"
          }
        }
      }
    },
