    "automations.source.input-description": {
      "comment": "Automation editor: explains the Run on a File source",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf die übergebene Datei angewendet: aus einer Quick-Access-Karte, dem Verlauf, der Befehlszeile oder Kurzbefehlen. Ohne Tastenkürzel, da nichts aufgenommen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on the file it’s given: from a Quick Access card, History, the command line or Shortcuts. It has no shortcut because there’s nothing to capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en el archivo que recibe: desde una tarjeta de Acceso rápido, el Historial, la línea de comandos o Atajos. No tiene atajo porque no hay nada que capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute sur le fichier reçu : depuis une carte Accès rapide, l’Historique, la ligne de commande ou Raccourcis. Pas de raccourci clavier, car il n’y a rien à capturer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל על הקובץ שמתקבל: מכרטיס גישה מהירה, מההיסטוריה, משורת הפקודה או מקיצורים. אין לו קיצור מקלדת כי אין מה לצלם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "渡されたファイル（クイックアクセスのカード、履歴、コマンドライン、ショートカット）に対して実行します。キャプチャしないため、ショートカットキーはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 접근 카드, 기록, 명령줄 또는 단축어에서 받은 파일에서 실행됩니다. 캡처할 대상이 없으므로 단축키가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается для переданного файла: из карточки быстрого доступа, истории, командной строки или «Быстрых команд». Сочетания клавиш нет, так как снимать нечего."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy trên tệp được truyền vào: từ thẻ Truy cập nhanh, Lịch sử, dòng lệnh hoặc Phím tắt. Không có phím tắt vì không có gì để chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对传入的文件运行：来自快速访问卡片、历史记录、命令行或快捷指令。因为无需截图，所以没有快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對傳入的檔案執行：來自快速存取卡片、歷史紀錄、命令列或捷徑。因為不需擷取，所以沒有快速鍵。"
          }
        }
      }
    },
