    "automations.editor.steps-description": {
      "comment": "Automation editor steps section description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schritte laufen in dieser Reihenfolge. Das Bild wird vor dem Hochladen kopiert, damit es auch bei einem Fehler zum Einfügen bereitliegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps run in this order. Copy image runs before the upload, so a failed upload still leaves the image to paste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos se ejecutan en este orden. La imagen se copia antes de subirla, así que aunque falle la subida puedes pegarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes s’exécutent dans cet ordre. L’image est copiée avant le téléversement : en cas d’échec, elle reste prête à coller."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלבים רצים בסדר הזה. העתקת התמונה מתבצעת לפני ההעלאה, כך שגם אם ההעלאה נכשלת התמונה מוכנה להדבקה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップはこの順に実行されます。画像のコピーはアップロード前に行われるため、アップロードに失敗しても画像を貼り付けられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계는 이 순서로 실행됩니다. 이미지 복사가 업로드보다 먼저 실행되므로 업로드에 실패해도 이미지를 붙여넣을 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги выполняются в этом порядке. Изображение копируется до загрузки, поэтому даже при ошибке его можно вставить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước chạy theo thứ tự này. Copy ảnh luôn chạy trước upload, nên nếu upload lỗi bạn vẫn có ảnh để dán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步骤按此顺序运行。复制图像会在上传之前执行，即使上传失败也能粘贴图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "步驟依此順序執行。拷貝影像會在上傳之前執行，即使上傳失敗也能貼上影像。"
          }
        }
      }
    },
