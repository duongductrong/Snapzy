    "automations.editor.save-to-folder": {
      "comment": "Automation editor toggle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Exportordner sichern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
