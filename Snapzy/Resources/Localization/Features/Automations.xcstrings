    "automations.rejection.needs-file": {
      "comment": "Automation could not be started: it runs on a file and none was given",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automation wird auf eine Datei angewendet. Übergib eine Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation runs on a file. Pass a file to run it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización se ejecuta en un archivo. Pasa un archivo para ejecutarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
