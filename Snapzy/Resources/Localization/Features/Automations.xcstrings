    "automations.translate.engine-note": {
      "comment": "Footer of the Translate step settings",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet Apple Übersetzen ab macOS 15 oder den für „Ausschnitt übersetzen“ gewählten Endpunkt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Translation on macOS 15 or later, or the endpoint chosen for Snip to Translate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la Traducción de Apple en macOS 15 o posterior, o el extremo elegido en Recortar y traducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise la traduction d’Apple sur macOS 15 ou ultérieur, ou le point de terminaison choisi pour Capturer pour traduire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש בתרגום של Apple ב-macOS 15 ואילך, או בנקודת הקצה שנבחרה עבור גזירה ותרגום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 以降では Appleの翻訳機能を、それ以外では「切り取って翻訳」で選んだエンドポイントを使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 15 이상에서는 Apple 번역을, 그 외에는 캡처하여 번역에서 선택한 엔드포인트를 사용합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует Apple Translation в macOS 15 и новее или адрес, выбранный для «Перевода фрагмента»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Apple Translation trên macOS 15 trở lên, hoặc endpoint đã chọn cho Chụp để dịch."
