    "automations.inspector.script.variables": {
      "comment": "Script inspector footer; variable names are code, keep them",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werte erreichen das Skript nur als Umgebungsvariablen – $SNAPZY_FILE, $SNAPZY_FILES (eine pro Zeile), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR – und die Dateien als $1, $2 … Sie werden nie in den Skripttext eingefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values reach the script only as environment variables — $SNAPZY_FILE, $SNAPZY_FILES (one per line), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — and the files as $1, $2… They are never inserted into the script text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores llegan al script solo como variables de entorno —$SNAPZY_FILE, $SNAPZY_FILES (uno por línea), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR— y los archivos como $1, $2… Nunca se insertan en el texto del script."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs n’arrivent au script que par des variables d’environnement — $SNAPZY_FILE, $SNAPZY_FILES (un par ligne), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — et les fichiers en $1, $2… Elles ne sont jamais insérées dans le texte du script."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכים מגיעים לסקריפט רק כמשתני סביבה — $SNAPZY_FILE, $SNAPZY_FILES (אחד בכל שורה), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — והקבצים כ-$1, $2… הם אף פעם לא מוכנסים לטקסט הסקריפט."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値は環境変数としてのみスクリプトに渡されます（$SNAPZY_FILE、$SNAPZY_FILES（1 行に 1 つ）、$SNAPZY_LINK、$SNAPZY_TEXT、$SNAPZY_AUTOMATION、$SNAPZY_RUN_ID、$SNAPZY_WORK_DIR）。ファイルは $1、$2… です。スクリプト本文に埋め込まれることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "값은 환경 변수로만 스크립트에 전달됩니다 — $SNAPZY_FILE, $SNAPZY_FILES(한 줄에 하나), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — 파일은 $1, $2…입니다. 스크립트 텍스트에 삽입되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения попадают в скрипт только через переменные окружения — $SNAPZY_FILE, $SNAPZY_FILES (по одному в строке), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — а файлы как $1, $2… В текст скрипта они не вставляются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá trị chỉ được truyền vào script qua biến môi trường — $SNAPZY_FILE, $SNAPZY_FILES (mỗi dòng một tệp), $SNAPZY_LINK, $SNAPZY_TEXT, $SNAPZY_AUTOMATION, $SNAPZY_RUN_ID, $SNAPZY_WORK_DIR — và các tệp là $1, $2… Chúng không bao giờ được chèn vào nội dung script."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值只通过环境变量传给脚本——$SNAPZY_FILE、$SNAPZY_FILES（每行一个）、$SNAPZY_LINK、$SNAPZY_TEXT、$SNAPZY_AUTOMATION、$SNAPZY_RUN_ID、$SNAPZY_WORK_DIR——文件为 $1、$2…，绝不会插入脚本文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數值只透過環境變數傳給指令碼——$SNAPZY_FILE、$SNAPZY_FILES（每行一個）、$SNAPZY_LINK、$SNAPZY_TEXT、$SNAPZY_AUTOMATION、$SNAPZY_RUN_ID、$SNAPZY_WORK_DIR——檔案為 $1、$2…，絕不會插入指令碼文字。"
          }
        }
      }
    },
