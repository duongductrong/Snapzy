    "automations.rejection.ambiguous": {
      "comment": "Automation could not be started: several automations share the name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehrere Automationen haben diesen Namen. Verwende stattdessen die ID."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several automations have that name. Use the automation’s id instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varias automatizaciones tienen ese nombre. Usa el id de la automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs automatisations portent ce nom. Utilisez plutôt l’identifiant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכמה אוטומציות יש את השם הזה. השתמשו במזהה של האוטומציה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のオートメーションが複数あります。代わりに ID を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 이름의 자동화가 여러 개 있습니다. 대신 ID를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несколько автоматизаций с таким именем. Используйте ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có nhiều tự động hóa trùng tên. Hãy dùng id thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有多个自动化使用该名称。请改用自动化的 ID。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有多個自動化使用該名稱。請改用自動化的 ID。"
          }
        }
      }
    },
