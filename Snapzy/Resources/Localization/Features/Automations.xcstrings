    "automations.hero-subtitle": {
      "comment": "Automations settings page subtitle",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem Kurzbefehl aufnehmen und teilen. Jede Automation nimmt auf und führt dann ihre Schritte der Reihe nach aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture and share with one shortcut. Each automation captures, then runs its steps in order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura y comparte con un atajo. Cada automatización captura y luego ejecuta sus pasos en orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturez et partagez avec un seul raccourci. Chaque automatisation capture, puis exécute ses étapes dans l’ordre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילום ושיתוף בקיצור דרך אחד. כל אוטומציה מצלמת ואז מריצה את השלבים שלה לפי הסדר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ひとつのショートカットでキャプチャして共有。各オートメーションはキャプチャ後、ステップを順に実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 하나로 캡처하고 공유하세요. 각 자동화는 캡처한 다음 단계를 순서대로 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте и делитесь одним сочетанием клавиш. Каждая автоматизация делает снимок, а затем по порядку выполняет свои шаги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp và chia sẻ chỉ với một phím tắt. Mỗi automation chụp màn hình rồi chạy lần lượt các bước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个快捷键完成截图和分享。每个自动化先截图，再按顺序执行各个步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個快速鍵完成擷取與分享。每個自動化先擷取，再依序執行各個步驟。"
          }
        }
      }
    },
