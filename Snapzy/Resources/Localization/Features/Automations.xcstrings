          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Apple Translation нужна macOS 15. Выберите адрес перевода в «Настройки → Захватить»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
