    "automations.intent.run-description": {
      "comment": "Shortcuts action description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt eine Snapzy-Automation aus: nimmt den Bildschirm auf oder nutzt die übergebenen Dateien und führt dann ihre Schritte aus. Gibt den Upload-Link oder den Dateipfad zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs a Snapzy automation: captures the screen, or uses the files you pass in, then runs its steps. Returns the uploaded link or the file path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta una automatización de Snapzy: captura la pantalla o usa los archivos que pases y luego ejecuta sus pasos. Devuelve el enlace subido o la ruta del archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute une automatisation Snapzy : capture l’écran ou utilise les fichiers transmis, puis exécute ses étapes. Renvoie le lien téléversé ou le chemin du fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפעיל אוטומציה של Snapzy: מצלם את המסך או משתמש בקבצים שהועברו, ואז מריץ את השלבים. מחזיר את הקישור שהועלה או את נתיב הקובץ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy のオートメーションを実行します。画面をキャプチャするか渡されたファイルを使い、ステップを実行します。アップロードしたリンクまたはファイルパスを返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 자동화를 실행합니다. 화면을 캡처하거나 전달된 파일을 사용한 다음 단계를 실행합니다. 업로드된 링크나 파일 경로를 반환합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает автоматизацию Snapzy: делает снимок экрана или использует переданные файлы, затем выполняет шаги. Возвращает ссылку загрузки или путь к файлу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy một tự động hóa Snapzy: chụp màn hình hoặc dùng các tệp được truyền vào, rồi chạy các bước. Trả về liên kết đã tải lên hoặc đường dẫn tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行 Snapzy 自动化：截取屏幕或使用传入的文件，然后运行其步骤。返回上传的链接或文件路径。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行 Snapzy 自動化：擷取螢幕或使用傳入的檔案，然後執行其步驟。回傳上傳的連結或檔案路徑。"
          }
        }
      }
    },
