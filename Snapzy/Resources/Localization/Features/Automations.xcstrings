    "automations.secret.error.invalid-name": {
      "comment": "Secret name validation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Buchstaben, Ziffern, „_“, „-“ oder „.“ (bis zu 64 Zeichen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use letters, digits, “_”, “-” or “.” (up to 64 characters)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa letras, dígitos, “_”, “-” o “.” (hasta 64 caracteres)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des lettres, chiffres, « _ », « - » ou « . » (64 caractères max)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש באותיות, ספרות, ״_״, ״-״ או ״.״ (עד 64 תווים)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "英字、数字、「_」「-」「.」のみ（64 文字まで）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자, 숫자, “_”, “-”, “.”만 사용하세요(최대 64자)."
          }
        },
        "ru": {
          "stringUnit": {
