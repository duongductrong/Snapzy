    "automations.error.ai-consent": {
      "comment": "Run error of the AI Describe step. %@ = provider name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden von Bildern an %@ ist noch nicht erlaubt. Führe diese Automation einmal in Snapzy aus, um zuzustimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending images to %@ isn't allowed yet. Run this automation from Snapzy once to agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se permite enviar imágenes a %@. Ejecuta esta automatización una vez desde Snapzy para aceptar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’envoi d’images à %@ n’est pas encore autorisé. Exécutez cette automatisation une fois depuis Snapzy pour accepter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין אין הרשאה לשלוח תמונות אל %@. הפעילו את האוטומציה הזו פעם אחת מתוך Snapzy כדי לאשר."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ への画像の送信はまだ許可されていません。同意するには Snapzy からこのオートメーションを一度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 %@(으)로 이미지를 보낼 수 없습니다. 동의하려면 Snapzy에서 이 자동화를 한 번 실행하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка изображений в %@ пока не разрешена. Запустите эту автоматизацию из Snapzy один раз, чтобы дать согласие."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được phép gửi ảnh tới %@. Hãy chạy tự động hoá này từ Snapzy một lần để đồng ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允许向 %@ 发送图像。请从 Snapzy 运行一次此自动化以表示同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未允許向 %@ 傳送影像。請從 Snapzy 執行一次此自動化以表示同意。"
          }
        }
      }
    },
    "automations.error.ai-not-configured": {
      "comment": "Run error of the AI Describe step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein KI-Anbieter kann Bilder ansehen. Füge unter Einstellungen → KI einen KI-Endpunkt oder eine Agent-CLI hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No AI provider can look at images. Add an AI endpoint or agent CLI in Settings → AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún proveedor de IA puede ver imágenes. Añade un extremo de IA o una CLI de agente en Ajustes → IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fournisseur d’IA ne peut analyser les images. Ajoutez un point de terminaison IA ou une CLI d’agent dans Réglages → IA."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אף ספק בינה מלאכותית לא יכול לראות תמונות. הוסיפו נקודת קצה או CLI של סוכן בהגדרות ← בינה מלאכותית."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を扱える AI プロバイダがありません。設定 → AI で AI エンドポイントかエージェント CLI を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 볼 수 있는 AI 제공자가 없습니다. 설정 → AI에서 AI 엔드포인트나 에이전트 CLI를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни один ИИ-провайдер не может работать с изображениями. Добавьте адрес ИИ или CLI-агента в «Настройки → ИИ»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có nhà cung cấp AI nào xem được ảnh. Hãy thêm endpoint AI hoặc agent CLI trong Cài đặt → AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有能查看图像的 AI 提供方。请在“设置 → AI”中添加 AI 端点或代理 CLI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有能查看影像的 AI 提供者。請在「設定 → AI」中加入 AI 端點或代理 CLI。"
          }
        }
      }
    },
