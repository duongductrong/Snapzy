        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלונות Figma ו-Sketch נשמרים בתיקיית העיצוב, וכל השאר בתיקיית הייצוא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma と Sketch のウインドウはデザインフォルダへ、それ以外は書き出しフォルダへ保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma와 Sketch 윈도우는 디자인 폴더로, 나머지는 내보내기 폴더로 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окна Figma и Sketch попадают в папку дизайна, всё остальное — в папку экспорта."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ Figma và Sketch vào thư mục thiết kế, mọi thứ khác vào thư mục xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma 和 Sketch 窗口存入设计文件夹，其他内容存入导出文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma 和 Sketch 視窗存入設計檔案夾，其他內容存入匯出檔案夾。"
          }
        }
      }
    },
    "automations.gallery.docs-shot": {
      "comment": "Gallery description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fensteraufnahme mit deiner Leinwandvorlage, auf 1600 px skaliert, als WebP in deinem Doku-Ordner gesichert, Markdown-Link kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window capture with your canvas preset, resized to 1600 px, saved as WebP to your docs folder with a Markdown link copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Captura de ventana con tu preajuste de lienzo, redimensionada a 1600 px, guardada como WebP en tu carpeta de documentación y con un enlace Markdown copiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture de fenêtre avec votre préréglage de canevas, redimensionnée à 1600 px, enregistrée en WebP dans votre dossier de documentation, avec un lien Markdown copié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צילום חלון עם ערכת הקנבס שלכם, בגודל 1600 px, נשמר כ-WebP בתיקיית התיעוד ומעתיק קישור Markdown."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンバスプリセットを適用したウインドウキャプチャを 1600 px にリサイズし、WebP としてドキュメントフォルダに保存して Markdown リンクをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캔버스 프리셋을 적용한 윈도우 캡처를 1600px로 크기 조절해 문서 폴더에 WebP로 저장하고 Markdown 링크를 복사합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимок окна с пресетом холста, уменьшенный до 1600 px, сохраняется в WebP в папку документации, а ссылка Markdown копируется."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chụp cửa sổ với preset khung nền của bạn, đổi cỡ về 1600 px, lưu dạng WebP vào thư mục tài liệu và sao chép liên kết Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的画布预设截取窗口，调整为 1600 px，以 WebP 格式保存到文档文件夹，并复制 Markdown 链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你的畫布預設擷取視窗，調整為 1600 px，以 WebP 格式儲存到文件檔案夾，並拷貝 Markdown 連結。"
          }
        }
      }
    },
