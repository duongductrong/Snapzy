    "automations.describe.convert": {
      "comment": "Inspector description of the Convert step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodiert das Bild mit Format, Qualität und Größenlimit neu oder mit einer Optimierungsvorlage aus dem Schnellzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-encodes the image with a format, quality and size limit, or a Quick Access Optimize preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a codificar la imagen con un formato, una calidad y un límite de tamaño, o con un preajuste de optimización de Acceso rápido."
          }
