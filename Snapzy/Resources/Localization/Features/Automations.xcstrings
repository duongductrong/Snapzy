    "automations.step.ai-annotate.describe": {
      "comment": "Inspector description of the AI Describe step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet das Bild und deinen Prompt an deinen KI-Anbieter. Die Antwort wird zu {text} für „Text kopieren“, Speichern oder einen Webhook."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends the image and your prompt to your AI provider. Its answer becomes {text} for Copy Text, Save or a webhook."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía la imagen y tu prompt a tu proveedor de IA. Su respuesta pasa a ser {text} para Copiar texto, Guardar o un webhook."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie l’image et votre prompt à votre fournisseur d’IA. Sa réponse devient {text} pour Copier le texte, Enregistrer ou un webhook."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח את התמונה וההנחיה שלכם לספק הבינה המלאכותית. התשובה הופכת ל-{text} עבור העתקת טקסט, שמירה או Webhook."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像とプロンプトを AI プロバイダに送信します。その回答は「テキストをコピー」、保存、Webhook で {text} として使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지와 프롬프트를 AI 제공자에게 보냅니다. 응답은 텍스트 복사, 저장 또는 웹훅에서 {text}로 사용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет изображение и ваш запрос вашему ИИ-провайдеру. Его ответ становится {text} для копирования текста, сохранения или вебхука."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi ảnh và prompt của bạn tới nhà cung cấp AI. Câu trả lời trở thành {text} cho Sao chép văn bản, Lưu hoặc webhook."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将图像和你的提示词发送给 AI 提供方。其回答会成为 {text}，可用于复制文本、保存或 Webhook。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將影像和你的提示詞傳送給 AI 提供者。其回答會成為 {text}，可用於拷貝文字、儲存或 Webhook。"
          }
        }
      }
    },
