    "automations.route.footer": {
      "comment": "Sheet footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach beenden. Andere Apps überspringen sie und führen die Schritte unter dem Block aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then stop. Other apps skip them and run the steps below the block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Luego se detiene. Las demás apps los omiten y ejecutan los pasos bajo el bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Puis arrêter. Les autres apps les sautent et exécutent les étapes sous le bloc."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ואז לעצור. אפליקציות אחרות מדלגות עליהם ומריצות את השלבים שמתחת לבלוק."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後停止します。他のアプリではスキップされ、ブロックの下のステップが実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 후 중지합니다. 다른 앱은 건너뛰고 블록 아래 단계를 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Затем стоп. Для других приложений они пропускаются и выполняются шаги под блоком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sau đó dừng. Ứng dụng khác sẽ bỏ qua và chạy các bước bên dưới khối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "然后停止。其他应用会跳过这些步骤，执行该块下方的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "然後停止。其他 App 會略過這些步驟，執行該區塊下方的步驟。"
          }
        }
      }
    },
