    "automations.redact.privacy-note": {
      "comment": "Redact inspector footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Erkennung läuft auf diesem Mac. Es wird nichts gesendet, und das Ausführungsprotokoll speichert nur, wie viele Bereiche verdeckt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detection runs on this Mac. Nothing is sent anywhere, and the run log keeps only how many areas were covered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección se hace en este Mac. No se envía nada a ningún sitio y el registro solo guarda cuántas áreas se ocultaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection s’effectue sur ce Mac. Rien n’est envoyé, et le journal ne conserve que le nombre de zones masquées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזיהוי מתבצע ב-Mac הזה. שום דבר לא נשלח, ויומן ההרצה שומר רק כמה אזורים הוסתרו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検出はこのMac上で行われます。どこにも送信されず、実行ログには隠した領域の数だけが残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감지는 이 Mac에서 실행됩니다. 아무것도 전송되지 않으며 실행 기록에는 가린 영역의 개수만 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание выполняется на этом Mac. Ничего никуда не отправляется, а в журнале сохраняется только число скрытых областей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc nhận diện chạy ngay trên máy Mac này. Không có gì được gửi đi, và nhật ký chạy chỉ lưu số vùng đã được che."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测在这台 Mac 上进行。不会发送任何内容，运行日志只记录遮盖了多少个区域。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "偵測在這台 Mac 上進行。不會傳送任何內容，執行記錄只記錄遮蓋了多少個區域。"
          }
        }
      }
    },
