    "automations.review.banner": {
      "comment": "Editor banner for an automation that needs review",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Netzwerk- oder Skript-Schritten importiert. Prüfe, was jeder Schritt sendet oder ausführt, und sichere dann, um die Automation zuzulassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported with network or script steps. Check what each step sends or runs, then save to allow this automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se importó con pasos de red o script. Comprueba qué envía o ejecuta cada paso y guarda para permitir esta automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importée avec des étapes réseau ou script. Vérifiez ce que chaque étape envoie ou exécute, puis enregistrez pour autoriser cette automatisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יובא עם שלבי רשת או סקריפט. יש לבדוק מה כל שלב שולח או מריץ, ואז לשמור כדי לאפשר את האוטומציה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークやスクリプトのステップ付きで読み込まれました。各ステップが何を送信・実行するか確認してから保存すると、このオートメーションが許可されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크 또는 스크립트 단계와 함께 가져왔습니다. 각 단계가 무엇을 보내거나 실행하는지 확인한 뒤 저장하면 이 자동화가 허용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортировано с сетевыми шагами или скриптами. Проверьте, что отправляет или запускает каждый шаг, и сохраните, чтобы разрешить автоматизацию."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được nhập kèm bước mạng hoặc script. Hãy kiểm tra từng bước gửi gì hoặc chạy gì, rồi lưu để cho phép automation này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入时包含网络或脚本步骤。请检查每个步骤发送或运行的内容，然后存储以允许此自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入時包含網路或指令碼步驟。請檢查每個步驟傳送或執行的內容，然後儲存以允許此自動化。"
          }
        }
      }
    },
