          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "{text}는 인식되거나 번역된 텍스트입니다. Markdown 이미지 링크에는 폴더에 저장 다음에 {saved.relativePath}를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} — распознанный или переведённый текст. Для ссылок на изображения в Markdown используйте {saved.relativePath} после шага «Сохранить в папку»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "{text} là văn bản đã nhận dạng hoặc đã dịch. Dùng {saved.relativePath} sau bước Lưu vào thư mục để tạo liên kết ảnh Markdown."
          }
        },
        "zh-Hans": {
          "stringUnit": {
