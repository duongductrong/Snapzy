    "automations.step.redact.describe": {
      "comment": "Inspector description of the Redact step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Findet E-Mail-Adressen, Telefonnummern, Kartennummern, Tokens, Gesichter oder Personen auf diesem Mac und verdeckt sie. Setze den Schritt vor jedes Hochladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds emails, phone numbers, card numbers, tokens, faces or people on this Mac and covers them. Put it before any upload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra correos, números de teléfono, números de tarjeta, tokens, caras o personas en este Mac y los oculta. Colócalo antes de cualquier subida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repère sur ce Mac les e-mails, numéros de téléphone, numéros de carte, jetons, visages ou personnes, et les masque. Placez-la avant tout téléversement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאתר ב-Mac הזה כתובות אימייל, מספרי טלפון, מספרי כרטיסים, טוקנים, פנים או אנשים ומסתיר אותם. יש למקם לפני כל העלאה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上でメールアドレス、電話番号、カード番号、トークン、顔、人物を検出して隠します。アップロードより前に配置してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 이메일, 전화번호, 카드 번호, 토큰, 얼굴 또는 사람을 찾아 가립니다. 업로드보다 앞에 두세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находит на этом Mac адреса почты, номера телефонов и карт, токены, лица или людей и скрывает их. Ставьте шаг перед любой загрузкой."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm email, số điện thoại, số thẻ, token, khuôn mặt hoặc người ngay trên máy Mac này và che chúng. Hãy đặt bước này trước mọi lần tải lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上查找电子邮件、电话号码、卡号、令牌、人脸或人物并将其遮盖。请把它放在所有上传之前。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上尋找電子郵件、電話號碼、卡號、權杖、人臉或人物並將其遮蓋。請把它放在所有上傳之前。"
          }
        }
      }
    },
