    "automations.show-in.input-description": {
      "comment": "Automation editor footer for the Show In section of a Run on a File automation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf die Datei des gewählten Eintrags angewendet. Für die Menüleiste ist eine Automation nötig, die aufnimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs on the selected item’s file. The menu bar needs an automation that captures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta en el archivo del elemento seleccionado. La barra de menús necesita una automatización que capture."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute sur le fichier de l’élément choisi. La barre des menus nécessite une automatisation qui capture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פועל על הקובץ של הפריט שנבחר. שורת התפריטים דורשת אוטומציה שמצלמת."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した項目のファイルに対して実行します。メニューバーにはキャプチャするオートメーションが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 항목의 파일에서 실행됩니다. 메뉴 막대에는 캡처하는 자동화가 필요합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускается для файла выбранного элемента. Для строки меню нужна автоматизация, которая делает снимок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy trên tệp của mục được chọn. Thanh menu cần tự động hóa có chụp màn hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对所选项目的文件运行。菜单栏需要会截图的自动化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對所選項目的檔案執行。選單列需要會擷取的自動化。"
          }
        }
      }
    },
