    "automations.ai.output-note": {
      "comment": "AI Describe inspector footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence kann keine Bilder sehen. Wähle daher einen KI-Endpunkt oder eine Agent-CLI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence can't see images, so pick an AI endpoint or agent CLI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no puede ver imágenes, así que elige un extremo de IA o una CLI de agente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ne peut pas voir les images : choisissez un point de terminaison IA ou une CLI d’agent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence לא יכול לראות תמונות, לכן יש לבחור נקודת קצה של בינה מלאכותית או CLI של סוכן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence は画像を認識できないため、AI エンドポイントかエージェント CLI を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence는 이미지를 볼 수 없으므로 AI 엔드포인트나 에이전트 CLI를 선택하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не видит изображения, поэтому выберите адрес ИИ или CLI-агента."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence không xem được ảnh, vì vậy hãy chọn endpoint AI hoặc agent CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 无法查看图像，请选择 AI 端点或代理 CLI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 無法查看影像，請選擇 AI 端點或代理 CLI。"
          }
        }
      }
    },
    "automations.ai.privacy-note": {
      "comment": "AI Describe inspector footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild verlässt diesen Mac. Snapzy fragt vor dem Senden einmal pro Anbieter; Ausführungen über die CLI oder Kurzbefehle schlagen fehl, bis du zugestimmt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image leaves this Mac. Snapzy asks once per provider before sending; runs from the CLI or Shortcuts fail until you have agreed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen sale de este Mac. Snapzy pregunta una vez por proveedor antes de enviarla; las ejecuciones desde la CLI o Atajos fallan hasta que aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image quitte ce Mac. Snapzy demande une fois par fournisseur avant l’envoi ; les exécutions depuis la CLI ou Raccourcis échouent tant que vous n’avez pas accepté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה יוצאת מה-Mac הזה. Snapzy שואל פעם אחת לכל ספק לפני השליחה; הרצות משורת הפקודה או מקיצורים ייכשלו עד שתאשרו."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像はこのMacの外に送信されます。Snapzy は送信前にプロバイダごとに一度確認します。同意するまで、CLI やショートカットからの実行は失敗します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지가 이 Mac 밖으로 전송됩니다. Snapzy는 보내기 전에 제공자마다 한 번 묻습니다. 동의하기 전까지 CLI나 단축어에서의 실행은 실패합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображение покидает этот Mac. Snapzy спрашивает один раз для каждого провайдера перед отправкой; запуски из CLI или «Команд» не сработают, пока вы не согласитесь."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ảnh sẽ rời khỏi máy Mac này. Snapzy hỏi một lần cho mỗi nhà cung cấp trước khi gửi; các lần chạy từ CLI hoặc Phím tắt sẽ lỗi cho đến khi bạn đồng ý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图像会离开这台 Mac。Snapzy 在发送前会针对每个提供方询问一次；在你同意之前，从 CLI 或快捷指令运行会失败。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影像會離開這台 Mac。Snapzy 在傳送前會針對每個提供者詢問一次；在你同意之前，從 CLI 或捷徑執行會失敗。"
          }
        }
      }
    },
