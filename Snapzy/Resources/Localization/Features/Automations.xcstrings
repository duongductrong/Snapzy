    "automations.external.code-description": {
      "comment": "Warning under the second opt-in",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dann könnte ein snapzy://-Link oder ein Kurzbefehl dieses Skript ausführen. Nur einschalten, wenn du allem vertraust, was auf diesem Mac Links öffnen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A snapzy:// link or a shortcut could then run this script. Turn on only if you trust everything that can open links on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así un enlace snapzy:// o un atajo podría ejecutar este script. Actívalo solo si confías en todo lo que puede abrir enlaces en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lien snapzy:// ou un raccourci pourrait alors exécuter ce script. N’activez cette option que si vous faites confiance à tout ce qui peut ouvrir des liens sur ce Mac."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כך קישור snapzy:// או קיצור יוכלו להריץ את הסקריפט. יש להפעיל רק אם סומכים על כל מה שיכול לפתוח קישורים במק הזה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "snapzy:// リンクやショートカットからこのスクリプトを実行できるようになります。この Mac でリンクを開けるものをすべて信頼できる場合にだけオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그러면 snapzy:// 링크나 단축어가 이 스크립트를 실행할 수 있습니다. 이 Mac에서 링크를 열 수 있는 모든 것을 신뢰할 때만 켜세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тогда ссылка snapzy:// или быстрая команда смогут запустить этот скрипт. Включайте, только если доверяете всему, что может открывать ссылки на этом Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi đó một link snapzy:// hoặc một phím tắt có thể chạy script này. Chỉ bật nếu bạn tin mọi thứ có thể mở link trên máy Mac này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样 snapzy:// 链接或快捷指令就能运行此脚本。只有在信任这台 Mac 上所有能打开链接的东西时才开启。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這樣 snapzy:// 連結或捷徑就能執行此指令碼。只有在信任這台 Mac 上所有能打開連結的東西時才開啟。"
          }
        }
      }
    },
