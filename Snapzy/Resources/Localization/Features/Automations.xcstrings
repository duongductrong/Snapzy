          "stringUnit": {
            "state": "translated",
            "value": "מקודד מחדש את התמונה עם פורמט, איכות ומגבלת גודל, או עם הגדרת אופטימיזציה מוכנה מהגישה המהירה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式、品質、サイズ上限、またはクイックアクセスの最適化プリセットで画像を再エンコードします。"
