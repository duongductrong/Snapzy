        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの Snapzy で作成されています。実行するにはアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 최신 버전의 Snapzy로 만들었습니다. 실행하려면 업데이트하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано в более новой версии Snapzy. Обновите приложение, чтобы запустить."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được tạo bằng phiên bản Snapzy mới hơn. Hãy cập nhật để chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由更新版本的 Snapzy 创建。请更新后运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由較新版本的 Snapzy 建立。請更新後執行。"
          }
