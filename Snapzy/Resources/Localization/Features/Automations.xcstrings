          "stringUnit": {
            "state": "translated",
            "value": "該当するオートメーションが 1 つだけなら選択をスキップ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "맞는 자동화가 하나뿐이면 선택 건너뛰기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не показывать список, если подходит одна автоматизация"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bỏ qua bảng chọn khi chỉ có một tự động hoá phù hợp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅一个自动化适用时跳过选择器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅一個自動化適用時略過選擇器"
          }
        }
      }
    },
    "automations.advanced.run-single-directly-description": {
      "comment": "Advanced toggle description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finders „Run Snapzy Automation…“ und auf das Menüleistensymbol gezogene Dateien führen sie dann sofort aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder’s “Run Snapzy Automation…” and files dropped on the menu bar icon then run it right away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El «Run Snapzy Automation…» de Finder y los archivos soltados en el icono de la barra de menús la ejecutan directamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Run Snapzy Automation… » du Finder et les fichiers déposés sur l’icône de la barre des menus l’exécutent alors directement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״Run Snapzy Automation…״ ב-Finder וקבצים שמשוחררים על סמל שורת התפריטים יריצו אותה מיד."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder の「Run Snapzy Automation…」やメニューバーアイコンへのドロップで、すぐに実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder의 ‘Run Snapzy Automation…’과 메뉴 막대 아이콘에 놓은 파일이 바로 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пункт Finder «Run Snapzy Automation…» и файлы, перетащенные на значок в строке меню, запустят её сразу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục “Run Snapzy Automation…” của Finder và tệp thả lên biểu tượng thanh menu sẽ chạy nó ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 的“Run Snapzy Automation…”和拖放到菜单栏图标的文件会直接运行它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder 的「Run Snapzy Automation…」與拖放到選單列圖像的檔案會直接執行它。"
          }
        }
      }
    },
    "automations.ai.consent.message": {
      "comment": "Consent alert message. %@ = host name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automation sendet jede Aufnahme, die sie verarbeitet, zusammen mit deinem Prompt an %@. Stimme nur zu, wenn du diesem Dienst deine Screenshots anvertraust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation sends each capture it runs on, with your prompt, to %@. Only agree if you trust that service with your screenshots."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización envía cada captura que procesa, junto con tu prompt, a %@. Acepta solo si confías tus capturas de pantalla a ese servicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette automatisation envoie chaque capture qu’elle traite, avec votre prompt, à %@. N’acceptez que si vous confiez vos captures d’écran à ce service."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האוטומציה הזו שולחת כל צילום שהיא מעבדת, יחד עם ההנחיה שלכם, אל %@. אשרו רק אם אתם סומכים על השירות הזה עם צילומי המסך שלכם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオートメーションは、処理する各キャプチャをプロンプトとともに %@ に送信します。そのサービスにスクリーンショットを預けても問題ない場合のみ同意してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 처리하는 각 캡처를 프롬프트와 함께 %@(으)로 보냅니다. 스크린샷을 맡겨도 될 만큼 해당 서비스를 신뢰하는 경우에만 동의하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта автоматизация отправляет каждый обрабатываемый снимок вместе с вашим запросом в %@. Соглашайтесь, только если доверяете этому сервису свои скриншоты."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hoá này gửi mỗi ảnh chụp mà nó xử lý, kèm prompt của bạn, tới %@. Chỉ đồng ý nếu bạn tin tưởng dịch vụ đó với ảnh chụp màn hình của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此自动化会将其处理的每张截图连同你的提示词发送到 %@。仅当你信任该服务处理你的截图时才同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此自動化會將其處理的每張截圖連同你的提示詞傳送到 %@。僅當你信任該服務處理你的截圖時才同意。"
          }
        }
      }
    },
    "automations.ai.consent.message-cli": {
      "comment": "Consent alert message for agent CLIs. %@ = CLI name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automation übergibt jede Aufnahme, die sie verarbeitet, zusammen mit deinem Prompt an %@. Das Tool leitet sie an seinen eigenen Modellanbieter weiter und kann deine MCP-Server und Hooks laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation hands each capture it runs on, with your prompt, to %@, which forwards it to its own model provider and may load your MCP servers and hooks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización pasa cada captura que procesa, junto con tu prompt, a %@, que la reenvía a su propio proveedor de modelos y puede cargar tus servidores MCP y hooks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette automatisation transmet chaque capture qu’elle traite, avec votre prompt, à %@, qui la relaie à son propre fournisseur de modèles et peut charger vos serveurs MCP et hooks."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האוטומציה הזו מעבירה כל צילום שהיא מעבדת, יחד עם ההנחיה שלכם, אל %@, שמעביר אותו לספק המודלים שלו ועשוי לטעון את שרתי ה-MCP וה-hooks שלכם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオートメーションは、処理する各キャプチャをプロンプトとともに %@ に渡します。キャプチャはそのツール独自のモデルプロバイダに転送され、MCP サーバやフックが読み込まれる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 처리하는 각 캡처를 프롬프트와 함께 %@에 넘깁니다. 이 CLI는 캡처를 자체 모델 제공자에게 전달하며 MCP 서버와 훅을 불러올 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта автоматизация передаёт каждый обрабатываемый снимок вместе с вашим запросом в %@. Он пересылает его своему провайдеру моделей и может загрузить ваши MCP-серверы и хуки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hoá này chuyển mỗi ảnh chụp mà nó xử lý, kèm prompt của bạn, cho %@. Công cụ này sẽ chuyển tiếp ảnh tới nhà cung cấp mô hình của nó và có thể tải các máy chủ MCP và hook của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此自动化会将其处理的每张截图连同你的提示词交给 %@，后者会将其转发给自己的模型提供方，并可能加载你的 MCP 服务器和钩子。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此自動化會將其處理的每張截圖連同你的提示詞交給 %@，後者會將其轉送給自己的模型提供者，並可能載入你的 MCP 伺服器和掛鉤。"
          }
        }
      }
    },
