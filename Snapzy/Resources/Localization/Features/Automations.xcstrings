    "automations.describe.upload": {
      "comment": "Inspector description of the Upload step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt die Datei in deine Cloud hoch. Füge „Link kopieren“ hinzu, um den Link in die Zwischenablage zu legen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads the file to your cloud. Add Copy link to put the link on the clipboard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el archivo a tu nube. Añade Copiar enlace para poner el enlace en el portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléverse le fichier vers votre cloud. Ajoutez Copier le lien pour placer le lien dans le presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מעלה את הקובץ לענן שלך. הוסיפו העתקת הקישור כדי לשים את הקישור בלוח."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをクラウドにアップロードします。リンクをクリップボードに入れるには「リンクをコピー」を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 클라우드에 업로드합니다. 링크를 클립보드에 넣으려면 링크 복사를 추가하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает файл в ваше облако. Добавьте «Скопировать ссылку», чтобы поместить ссылку в буфер обмена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải tệp lên Cloud của bạn. Thêm bước Sao chép liên kết để đưa liên kết vào bộ nhớ tạm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件上传到你的云端。添加“复制链接”可将链接放到剪贴板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案上傳到你的雲端。加入「拷貝連結」可將連結放到剪貼簿。"
          }
        }
      }
    },
    "automations.describe.webhook": {
      "comment": "Inspector description of the webhook step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet eine HTTP-Anfrage, etwa den Link an einen Slack- oder Discord-Kanal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends an HTTP request, for example the link to a Slack or Discord channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía una solicitud HTTP, por ejemplo el enlace a un canal de Slack o Discord."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie une requête HTTP, par exemple le lien vers un canal Slack ou Discord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שולח בקשת HTTP, למשל את הקישור לערוץ Slack או Discord."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP リクエストを送信します。たとえばリンクを Slack や Discord のチャンネルに送ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP 요청을 보냅니다. 예를 들어 링크를 Slack 또는 Discord 채널로 보냅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправляет HTTP-запрос, например ссылку в канал Slack или Discord."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi một yêu cầu HTTP, ví dụ gửi link vào kênh Slack hoặc Discord."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送 HTTP 请求，例如把链接发到 Slack 或 Discord 频道。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
