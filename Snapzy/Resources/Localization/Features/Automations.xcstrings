    "automations.describe.ask": {
      "comment": "Inspector description of the Ask step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt eine Auswahl am Zeiger. Die gewählte Automation läuft mit der aktuellen Datei und beendet diesen Lauf; „Fortfahren“ geht zum nächsten Schritt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows a picker at the pointer. The chosen automation runs on the current file and ends this run; “Continue” goes on with the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra un selector junto al puntero. La automatización elegida se ejecuta con el archivo actual y termina esta ejecución; «Continuar» sigue con el siguiente paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche un sélecteur au pointeur. L’automatisation choisie s’exécute sur le fichier actuel et termine cette exécution ; « Continuer » passe à l’étape suivante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג בורר ליד הסמן. האוטומציה שנבחרה רצה על הקובץ הנוכחי ומסיימת את ההרצה; ״המשך״ עובר לשלב הבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの位置に選択肢を表示します。選んだオートメーションが現在のファイルに実行され、この実行は終了します。「続ける」は次のステップに進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 위치에 선택 목록을 표시합니다. 선택한 자동화가 현재 파일에 실행되고 이 실행은 끝납니다. ‘계속’은 다음 단계로 진행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает список у указателя. Выбранная автоматизация выполняется для текущего файла и завершает этот запуск; «Продолжить» переходит к следующему шагу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện bảng chọn tại con trỏ. Tự động hoá được chọn sẽ chạy trên tệp hiện tại và kết thúc lần chạy này; “Tiếp tục” sẽ sang bước kế tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指针处显示选择器。所选自动化会在当前文件上运行并结束本次运行；“继续”则进入下一步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指標處顯示選擇器。所選自動化會在目前檔案上執行並結束本次執行；「繼續」則進入下一步。"
          }
        }
      }
    },
    "automations.describe.canvas-preset": {
      "comment": "Inspector description of the Apply canvas preset step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Hintergrund, Abstand und Schatten einer Annotate-Leinwandvorlage hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds the background, padding and shadow of an Annotate canvas preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade el fondo, el margen y la sombra de un preajuste de lienzo de Annotate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute l’arrière-plan, la marge et l’ombre d’un préréglage de canevas Annotate."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוסיף את הרקע, הריווח והצל של ערכת קנבס מ-Annotate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate のキャンバスプリセットの背景、余白、影を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Annotate 캔버스 프리셋의 배경, 여백, 그림자를 추가합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет фон, отступы и тень из пресета холста Annotate."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nền, khoảng đệm và đổ bóng của một preset khung nền Annotate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 Annotate 画布预设中的背景、边距和阴影。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入 Annotate 畫布預設中的背景、邊距和陰影。"
          }
        }
      }
    },
    "automations.describe.condition": {
      "comment": "Inspector description of the Condition step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fährt nur fort, wenn der Lauf passt. Sonst endet der Lauf oder überspringt die nächsten Schritte – „Bedingung · A · Stopp · B“ führt also A oder B aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continues only when the run matches. Otherwise the run stops or skips the next steps, so “condition · A · stop · B” runs A or B."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continúa solo si la ejecución coincide. Si no, se detiene u omite los pasos siguientes, así que «condición · A · detener · B» ejecuta A o B."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue seulement si l’exécution correspond. Sinon, elle s’arrête ou saute les étapes suivantes : « condition · A · arrêter · B » exécute A ou B."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממשיך רק כשההרצה תואמת. אחרת ההרצה נעצרת או מדלגת על השלבים הבאים, כך ש״תנאי · A · עצירה · B״ מריץ את A או את B."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行が条件に一致するときだけ続行します。一致しない場合は停止するか次のステップをスキップするので、「条件 · A · 停止 · B」で A か B を実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행이 조건에 맞을 때만 계속합니다. 맞지 않으면 중지하거나 다음 단계를 건너뛰므로 ‘조건 · A · 중지 · B’는 A 또는 B를 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжает, только если запуск подходит. Иначе запуск останавливается или пропускает следующие шаги, так что «условие · A · стоп · B» выполняет A или B."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ tiếp tục khi lần chạy khớp điều kiện. Nếu không, lần chạy dừng hoặc bỏ qua các bước kế tiếp, nên “điều kiện · A · dừng · B” sẽ chạy A hoặc B."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在运行符合条件时继续。否则停止运行或跳过后续步骤，因此“条件 · A · 停止 · B”会执行 A 或 B。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
