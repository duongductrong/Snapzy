    "automations.editor.save-to-folder-description": {
      "comment": "Automation editor toggle description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aus, bleibt die Aufnahme im temporären Ordner von Snapzy, wie beim Ausschalten von „Sichern“ nach der Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the capture stays in Snapzy’s temporary folder, like turning off Save after capture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si está desactivado, la captura se queda en la carpeta temporal de Snapzy, como al desactivar Guardar después de capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé, la capture reste dans le dossier temporaire de Snapzy, comme lorsque Enregistrer après capture est désactivé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כשהאפשרות כבויה, הצילום נשאר בתיקייה הזמנית של Snapzy, כמו כשמכבים שמירה לאחר צילום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、キャプチャ後の保存をオフにしたときと同様に、Snapzy の一時フォルダに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄면 캡처 후 저장을 끈 것처럼 Snapzy 임시 폴더에 남습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если выключено, снимок остаётся во временной папке Snapzy, как при отключённом сохранении после съёмки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, ảnh chụp nằm trong thư mục tạm của Snapzy, giống như tắt Lưu sau khi chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭后，截图会留在 Snapzy 的临时文件夹中，与关闭截图后保存相同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉後，截圖會留在 Snapzy 的暫存檔案夾中，與關閉擷取後儲存相同。"
          }
        }
      }
    },
