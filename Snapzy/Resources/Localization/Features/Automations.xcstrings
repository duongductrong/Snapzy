    "automations.describe.save-to-folder": {
      "comment": "Inspector description of the Save to folder step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichert eine Kopie des Ergebnisses. Die ursprüngliche Aufnahme wird nie verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
