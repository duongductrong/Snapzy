    "automations.error.translation-timed-out": {
      "comment": "Step error: Apple Translation did not answer in time",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Übersetzung. Lade die Sprache unter Systemeinstellungen → Allgemein → Sprache & Region → Übersetzungssprachen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
