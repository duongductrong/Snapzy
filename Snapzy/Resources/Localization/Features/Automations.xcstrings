        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette automatisation ne peut pas être exécutée depuis d’autres apps. Autorisez-le dans Réglages → Automatisations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להפעיל את האוטומציה הזו מאפליקציות אחרות. אפשרו זאת בהגדרות ← אוטומציות."
