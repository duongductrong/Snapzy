    "automations.rejection.code-steps-disabled": {
      "comment": "Launch refused",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automation führt ein Skript oder einen Kurzbefehl aus; solche Schritte sind unter Einstellungen → Automationen ausgeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation runs a script or Shortcut, and those steps are turned off in Settings → Automations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización ejecuta un script o atajo, y esos pasos están desactivados en Ajustes → Automatizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette automatisation exécute un script ou un raccourci, et ces étapes sont désactivées dans Réglages → Automatisations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האוטומציה מריצה סקריפט או קיצור, והשלבים האלה כבויים בהגדרות → אוטומציות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオートメーションはスクリプトかショートカットを実行しますが、それらのステップは「設定 → オートメーション」でオフになっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 스크립트나 단축어를 실행하지만, 해당 단계가 설정 → 자동화에서 꺼져 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизация запускает скрипт или быструю команду, а такие шаги отключены в «Настройки → Автоматизации»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation này chạy script hoặc phím tắt, mà các bước đó đang tắt trong Cài đặt → Automation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此自动化会运行脚本或快捷指令，而这些步骤在“设置 → 自动化”中已关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此自動化會執行指令碼或捷徑，而這些步驟在「設定 → 自動化」中已關閉。"
          }
        }
      }
    },
