          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ dùng chữ, số, “_”, “-” hoặc “.” (tối đa 64 ký tự)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
