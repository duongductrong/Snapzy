          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 파일에서 실행됩니다. 실행하려면 파일을 전달하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта автоматизация работает с файлом. Передайте файл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hóa này chạy trên tệp. Hãy truyền tệp vào để chạy."
          }
