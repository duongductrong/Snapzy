    "automations.system-default.section-footer": {
      "comment": "Footer of the default after-capture section",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Screenshot und jede Aufzeichnung, die nicht von einer Automation gestartet wurde, führt diese Schritte aus. Die Optionen „Nach der Aufnahme“ in den Erfassen-Einstellungen bearbeiten dieselben Abläufe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every screenshot or recording not started by an automation runs these steps. The After Capture options in Capture settings edit the same pipelines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada captura de pantalla o grabación que no inicia una automatización ejecuta estos pasos. Las opciones de Después de la captura en los ajustes de Captura editan los mismos flujos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque capture d’écran ou enregistrement non lancé par une automatisation exécute ces étapes. Les options Après la capture des réglages Capturer modifient les mêmes enchaînements."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל צילום מסך או הקלטה שלא הופעלו על ידי אוטומציה מריצים את השלבים האלה. האפשרויות ״אחרי הצילום״ בהגדרות הצילום עורכות את אותם תהליכים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションから開始されていないすべてのスクリーンショットと録画で、これらのステップが実行されます。撮影設定の「撮影後」オプションでも同じ処理を編集できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화로 시작하지 않은 모든 스크린샷과 녹화는 이 단계를 실행합니다. 캡처 설정의 캡처 후 옵션도 같은 파이프라인을 편집합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти шаги выполняются для каждого снимка экрана или записи, запущенных не автоматизацией. Параметры «После захвата» в настройках захвата меняют те же цепочки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ảnh chụp hoặc bản quay màn hình không do tự động hoá khởi chạy đều chạy các bước này. Các tuỳ chọn Sau khi chụp trong cài đặt Chụp chỉnh sửa cùng các quy trình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有不是由自动化启动的截图或录制都会运行这些步骤。“截屏”设置中的“截取后”选项编辑的也是同样的流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有不是由自動化啟動的截圖或錄製都會執行這些步驟。「截圖」設定中的「擷取後」選項編輯的也是同樣的流程。"
          }
        }
      }
    },
