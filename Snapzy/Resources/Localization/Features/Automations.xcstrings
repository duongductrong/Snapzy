          }
        }
      }
    },
    "automations.rejection.needs-review": {
      "comment": "Launch refused",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Automation wurde mit Netzwerk- oder Skript-Schritten importiert. Öffne und sichere sie, um sie zuzulassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation was imported with network or script steps. Open it and save it to allow it to run."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización se importó con pasos de red o script. Ábrela y guárdala para permitir que se ejecute."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette automatisation a été importée avec des étapes réseau ou script. Ouvrez-la et enregistrez-la pour l’autoriser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האוטומציה יובאה עם שלבי רשת או סקריפט. יש לפתוח ולשמור אותה כדי לאפשר הרצה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオートメーションはネットワークやスクリプトのステップ付きで読み込まれました。開いて保存すると実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 자동화는 네트워크 또는 스크립트 단계와 함께 가져왔습니다. 열어서 저장해야 실행할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматизация импортирована с сетевыми шагами или скриптами. Откройте и сохраните её, чтобы разрешить запуск."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automation này được nhập kèm bước mạng hoặc script. Hãy mở và lưu lại để cho phép chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此自动化导入时包含网络或脚本步骤。请打开并存储后才能运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此自動化匯入時包含網路或指令碼步驟。請打開並儲存後才能執行。"
          }
        }
      }
    },
