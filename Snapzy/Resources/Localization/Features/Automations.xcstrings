          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce el texto reconocido con el motor elegido en Recortar y traducir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduit le texte reconnu avec le moteur choisi pour Capturer pour traduire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מתרגם את הטקסט שזוהה באמצעות המנוע שנבחר עבור גזירה ותרגום."
