    "automations.ask.choices-footer": {
      "comment": "Ask inspector footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zifferntasten 1–9 wählen eine Option, Esc bricht ab. Ausgeschaltete Automationen werden ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Number keys 1–9 pick a choice, Esc cancels. Turned-off automations are hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las teclas 1–9 eligen una opción y Esc cancela. Las automatizaciones desactivadas se ocultan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les touches 1 à 9 choisissent, Échap annule. Les automatisations désactivées sont masquées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקשי 1–9 בוחרים אפשרות, Esc מבטל. אוטומציות כבויות מוסתרות."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "数字キー 1〜9 で選択、Esc でキャンセル。オフのオートメーションは表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자 키 1–9로 선택하고 Esc로 취소합니다. 꺼진 자동화는 숨겨집니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клавиши 1–9 выбирают вариант, Esc отменяет. Выключенные автоматизации скрыты."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phím số 1–9 để chọn, Esc để huỷ. Tự động hoá đang tắt sẽ bị ẩn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数字键 1–9 选择，Esc 取消。已关闭的自动化不会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "數字鍵 1–9 選擇，Esc 取消。已關閉的自動化不會顯示。"
          }
        }
      }
    },
