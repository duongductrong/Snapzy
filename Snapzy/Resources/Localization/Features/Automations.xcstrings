    "automations.inspector.code-off": {
      "comment": "Inspector banner for script/Shortcut steps",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Skript- und Kurzbefehl-Schritte sind aus. Dieser Schritt läuft erst, wenn du sie erlaubst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Script and Shortcut steps are off. This step won’t run until you allow them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pasos de script y atajos están desactivados. Este paso no se ejecutará hasta que los permitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étapes de script et de raccourci sont désactivées. Cette étape ne s’exécutera pas tant que vous ne les autorisez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלבי סקריפט וקיצורים כבויים. השלב הזה לא ירוץ עד שתאפשר אותם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトとショートカットのステップはオフです。許可するまでこのステップは実行されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트 및 단축어 단계가 꺼져 있습니다. 허용하기 전까지 이 단계는 실행되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаги со скриптами и быстрыми командами отключены. Этот шаг не запустится, пока вы их не разрешите."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bước script và phím tắt đang tắt. Bước này sẽ không chạy cho đến khi bạn cho phép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本和快捷指令步骤已关闭。允许之前此步骤不会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
