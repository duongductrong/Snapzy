          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Made with a newer version of Snapzy. Update to run it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada con una versión más reciente de Snapzy. Actualiza para ejecutarla."
