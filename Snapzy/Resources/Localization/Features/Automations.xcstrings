    "automations.gallery.design-router": {
      "comment": "Gallery description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma- und Sketch-Fenster landen im Design-Ordner, alles andere im Exportordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Figma and Sketch windows go to your design folder, everything else to the export folder."
          }
        },
