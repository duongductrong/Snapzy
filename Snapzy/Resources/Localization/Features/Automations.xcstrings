    "automations.import.url-confirm.message": {
      "comment": "Alert message before importing a recipe from a link",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy lädt die Datei und zeigt, was sie enthält. Es wird nichts hinzugefügt oder aktiviert, bis du dich zum Importieren entscheidest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy downloads the file and shows what it contains. Nothing is added or turned on until you choose to import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy descarga el archivo y muestra lo que contiene. No se añade ni se activa nada hasta que decidas importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy télécharge le fichier et affiche son contenu. Rien n’est ajouté ni activé tant que vous ne choisissez pas d’importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy מוריד את הקובץ ומציג מה יש בו. שום דבר לא נוסף או מופעל עד שתבחרו לייבא."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy はファイルをダウンロードして内容を表示します。読み込むまで、何も追加・有効化されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy가 파일을 다운로드하고 내용을 보여 줍니다. 가져오기를 선택하기 전에는 아무것도 추가되거나 켜지지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy загрузит файл и покажет его содержимое. Ничего не будет добавлено или включено, пока вы не решите импортировать."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy sẽ tải tệp xuống và hiển thị nội dung bên trong. Không có gì được thêm hay bật cho đến khi bạn chọn nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 会下载该文件并显示其内容。在你选择导入之前，不会添加或开启任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 會下載該檔案並顯示其內容。在你選擇匯入之前，不會加入或開啟任何內容。"
          }
        }
      }
    },
