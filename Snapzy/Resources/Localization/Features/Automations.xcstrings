            "state": "translated",
            "value": "Сохранять в папку экспорта"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu vào thư mục xuất"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到导出文件夹"
          }
        },
        "zh-Hant": {
