    "automations.editor.duplicate-name": {
      "comment": "Automation editor warning: another automation has the same name",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Automation hat denselben Namen. Verwende die ID, um sie über die Befehlszeile oder eine URL auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another automation has this name. Use the id to run it from the command line or a URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra automatización tiene este nombre. Usa el id para ejecutarla desde la línea de comandos o una URL."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre automatisation porte ce nom. Utilisez l’identifiant pour l’exécuter depuis la ligne de commande ou une URL."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאוטומציה אחרת יש את אותו השם. השתמשו במזהה כדי להפעיל אותה משורת הפקודה או מכתובת URL."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ名前のオートメーションがあります。コマンドラインや URL から実行するには ID を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 자동화가 있습니다. 명령줄이나 URL에서 실행하려면 ID를 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть другая автоматизация с таким именем. Чтобы запускать её из командной строки или по URL, используйте ID."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã có tự động hóa khác trùng tên. Dùng id để chạy nó từ dòng lệnh hoặc URL."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个自动化使用了相同名称。请使用 ID 从命令行或 URL 运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個自動化使用了相同名稱。請使用 ID 從命令列或 URL 執行。"
          }
        }
      }
    },
