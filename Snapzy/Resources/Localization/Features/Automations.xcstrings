    "automations.toolbar.settings.automations-note": {
      "comment": "Settings footer",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automationen erscheinen hier, wenn „Aufnahme-Symbolleiste“ in ihren Auslösern aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automations appear here when “Capture toolbar” is on in their triggers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las automatizaciones aparecen aquí cuando «Barra de captura» está activado en sus activadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les automatisations apparaissent ici quand « Barre de capture » est activé dans leurs déclencheurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אוטומציות מופיעות כאן כאשר ״סרגל הצילום״ מופעל בטריגרים שלהן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガで「キャプチャツールバー」をオンにしたオートメーションがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거에서 ‘캡처 도구 막대’를 켠 자동화가 여기에 표시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появляются автоматизации, у которых в триггерах включена «Панель захвата»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động hoá xuất hiện ở đây khi “Thanh công cụ chụp” được bật trong phần kích hoạt của chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在触发方式中开启了“截图工具栏”的自动化会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在觸發方式中開啟了「截圖工具列」的自動化會顯示在這裡。"
          }
        }
      }
    },
    "automations.toolbar.settings.description": {
      "comment": "Capture settings section description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Bereich und dann in der Symbolleiste darunter, was passieren soll. Drücke den Buchstaben einer Schaltfläche, Return für die erste oder Esc zum Abbrechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an area, then pick what to do from a toolbar under it. Press a button's letter, Return for the first one, or Esc to cancel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un área y elige qué hacer en la barra que aparece debajo. Pulsa la letra de un botón, Return para el primero o Esc para cancelar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une zone, puis choisissez l’action dans la barre qui apparaît dessous. Appuyez sur la lettre d’un bouton, sur Return pour le premier ou sur Esc pour annuler."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחרו אזור ואז בחרו מה לעשות מהסרגל שמתחתיו. הקישו על האות של כפתור, על Return עבור הראשון או על Esc לביטול."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲を選択し、その下のツールバーで操作を選びます。ボタンの文字キーを押すか、Return で最初のボタン、Esc でキャンセルします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영역을 선택한 다음 아래 도구 막대에서 할 작업을 고릅니다. 버튼의 문자 키를 누르거나, Return으로 첫 번째 버튼을, Esc로 취소합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите область и выберите действие на панели под ней. Нажмите букву кнопки, Return для первой или Esc для отмены."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một vùng, rồi chọn thao tác từ thanh công cụ bên dưới. Nhấn chữ cái của nút, Return cho nút đầu tiên hoặc Esc để huỷ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个区域，然后在其下方的工具栏中选择操作。按按钮对应的字母键，按 Return 选择第一个，或按 Esc 取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個區域，然後在其下方的工具列中選擇動作。按按鈕對應的字母鍵，按 Return 選擇第一個，或按 Esc 取消。"
          }
        }
      }
    },
