    "automations.system-default.editor-note": {
      "comment": "Banner in the editor for a default after-capture automation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft nach jeder Aufnahme, die keine Automation gestartet hat. Die Option zum Speichern findest du in den Erfassen-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs after every capture that no automation started. Its Save option is in Capture settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ejecuta después de cada captura que no haya iniciado una automatización. Su opción Guardar está en los ajustes de Captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’exécute après chaque capture qui n’a pas été lancée par une automatisation. Son option Enregistrer se trouve dans les réglages Capturer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רץ אחרי כל צילום שלא הופעל על ידי אוטומציה. אפשרות השמירה נמצאת בהגדרות הצילום."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションから開始されていないすべての撮影の後に実行されます。保存オプションは撮影設定にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동화로 시작하지 않은 모든 캡처 후에 실행됩니다. 저장 옵션은 캡처 설정에 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняется после каждого захвата, запущенного не автоматизацией. Параметр сохранения находится в настройках захвата."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy sau mọi lần chụp không do tự động hoá khởi chạy. Tuỳ chọn Lưu nằm trong cài đặt Chụp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在每次不是由自动化启动的截取后运行。其“保存”选项位于“截屏”设置中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在每次不是由自動化啟動的擷取後執行。其「儲存」選項位於「截圖」設定中。"
          }
        }
      }
    },
