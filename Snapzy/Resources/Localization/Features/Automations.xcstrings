          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de la traducción. Descarga el idioma en Ajustes del Sistema → General → Idioma y región → Idiomas de traducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
