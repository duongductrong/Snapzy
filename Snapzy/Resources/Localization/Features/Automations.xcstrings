    "automations.list-description": {
      "comment": "Automations settings section description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weise einer Automation einen Kurzbefehl zu, um sie auszuführen. Ihre Aufnahmen überspringen die Aktionen nach der Aufnahme und folgen ihren Schritten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give an automation a shortcut to run it. Its captures skip the after-capture actions and follow its steps instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un atajo a una automatización para ejecutarla. Sus capturas omiten las acciones posteriores y siguen sus pasos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attribuez un raccourci à une automatisation pour l’exécuter. Ses captures ignorent les actions après capture et suivent ses étapes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקצו קיצור דרך לאוטומציה כדי להריץ אותה. הצילומים שלה מדלגים על הפעולות שלאחר הצילום ופועלים לפי השלבים שלה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを割り当てて実行します。オートメーションのキャプチャはキャプチャ後のアクションを使わず、そのステップに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키를 지정해 자동화를 실행하세요. 자동화로 찍은 캡처는 캡처 후 동작 대신 자동화의 단계를 따릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Назначьте автоматизации сочетание клавиш, чтобы запускать её. Её снимки пропускают действия после съёмки и выполняют её шаги."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gán phím tắt để chạy automation. Ảnh chụp từ automation bỏ qua các hành động sau khi chụp và làm theo các bước của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为自动化设置快捷键即可运行。它的截图会跳过截图后操作，改为执行它的步骤。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為自動化設定快速鍵即可執行。它的截圖會略過擷取後動作，改為執行它的步驟。"
          }
        }
      }
    },
