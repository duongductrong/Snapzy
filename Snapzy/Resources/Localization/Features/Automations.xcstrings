        }
      }
    },
    "automations.describe.convert": {
      "comment": "Inspector description of the Convert step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodiert das Bild mit Format, Qualität und Größenlimit neu oder mit einer Optimierungsvorlage aus dem Schnellzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-encodes the image with a format, quality and size limit, or a Quick Access Optimize preset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a codificar la imagen con un formato, una calidad y un límite de tamaño, o con un preajuste de optimización de Acceso rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réencode l’image avec un format, une qualité et une limite de taille, ou un préréglage d’optimisation d’Accès rapide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקודד מחדש את התמונה עם פורמט, איכות ומגבלת גודל, או עם הגדרת אופטימיזציה מוכנה מהגישה המהירה."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "形式、品質、サイズ上限、またはクイックアクセスの最適化プリセットで画像を再エンコードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형식, 품질, 크기 제한 또는 빠른 액세스 최적화 프리셋으로 이미지를 다시 인코딩합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекодирует изображение с заданным форматом, качеством и лимитом размера или по пресету оптимизации быстрого доступа."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hoá lại ảnh theo định dạng, chất lượng và giới hạn dung lượng, hoặc theo một preset Tối ưu của Truy cập nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按格式、质量和大小上限，或使用快速访问的优化预设，重新编码图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依格式、品質和大小上限，或使用快速存取的最佳化預設，重新編碼影像。"
          }
        }
      }
    },
