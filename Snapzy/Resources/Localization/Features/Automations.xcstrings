    "automations.describe.run-automation": {
      "comment": "Inspector description of the Run Automation step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt die Schritte einer anderen Automation für die aktuelle Datei aus und fährt dann fort. Deren Quelle und Auslöser werden ignoriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs another automation’s steps on the current file, then continues. Its source and triggers are ignored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta los pasos de otra automatización con el archivo actual y continúa. Se ignoran su origen y activadores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute les étapes d’une autre automatisation sur le fichier actuel, puis continue. Sa source et ses déclencheurs sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מריץ את השלבים של אוטומציה אחרת על הקובץ הנוכחי ואז ממשיך. המקור וההפעלות שלה אינם בשימוש."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のオートメーションのステップを現在のファイルに実行してから続行します。そのソースとトリガーは無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 파일에 다른 자동화의 단계를 실행한 뒤 계속합니다. 해당 자동화의 소스와 트리거는 무시됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет шаги другой автоматизации для текущего файла и продолжает. Её источник и триггеры не используются."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy các bước của một tự động hoá khác trên tệp hiện tại rồi tiếp tục. Nguồn và trình kích hoạt của nó bị bỏ qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对当前文件运行另一个自动化的步骤，然后继续。其来源和触发器会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對目前檔案執行另一個自動化的步驟，然後繼續。其來源與觸發條件會被忽略。"
          }
        }
      }
    },
    "automations.describe.run-script": {
      "comment": "Inspector description of the script step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
