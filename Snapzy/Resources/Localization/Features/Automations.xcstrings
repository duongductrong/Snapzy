            "value": "Diese Automation kann nicht aus anderen Apps ausgeführt werden. Erlaube es unter Einstellungen → Automationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This automation can’t be run from other apps. Allow it in Settings → Automations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta automatización no se puede ejecutar desde otras apps. Permítelo en Ajustes → Automatizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
