    "automations.describe.translate": {
      "comment": "Inspector description of the Translate step",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzt den erkannten Text mit dem Dienst, der für „Ausschnitt übersetzen“ gewählt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
