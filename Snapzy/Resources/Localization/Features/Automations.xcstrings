    "automations.gallery.safe-share": {
      "comment": "Gallery description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mail-Adressen, Telefon- und Kartennummern sowie Tokens auf diesem Mac verdecken, dann hochladen und den Link kopieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover emails, phone and card numbers and tokens on this Mac, then upload and copy the link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta correos, números de teléfono y de tarjeta y tokens en este Mac; después sube la imagen y copia el enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquez sur ce Mac les e-mails, numéros de téléphone et de carte et les jetons, puis téléversez et copiez le lien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסתרת כתובות אימייל, מספרי טלפון וכרטיסים וטוקנים ב-Mac הזה, ואז העלאה והעתקת הקישור."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac上でメールアドレス、電話番号、カード番号、トークンを隠してから、アップロードしてリンクをコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 이메일, 전화번호, 카드 번호와 토큰을 가린 뒤 업로드하고 링크를 복사합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает на этом Mac адреса почты, номера телефонов и карт и токены, затем загружает изображение и копирует ссылку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Che email, số điện thoại, số thẻ và token ngay trên máy Mac này, rồi tải lên và sao chép liên kết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 Mac 上遮盖电子邮件、电话号码、卡号和令牌，然后上传并复制链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這台 Mac 上遮蓋電子郵件、電話號碼、卡號和權杖，然後上傳並拷貝連結。"
          }
        }
      }
    },
    "automations.gallery.share-menu": {
      "comment": "Gallery description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tastenkürzel, dann nach der Aufnahme „Schnell kopieren“, „Cloud-Freigabe“ oder „Doku-Screenshot“ wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One shortcut, then pick Quick Copy, Cloud Share or Docs Shot after capturing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo atajo y, tras capturar, eliges Copia rápida, Compartir en la nube o Captura para documentación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul raccourci, puis choisissez Copie rapide, Partage cloud ou Capture pour la doc après la capture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצור אחד, ואחרי הצילום בוחרים ״העתקה מהירה״, ״שיתוף בענן״ או ״צילום לתיעוד״."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットひとつで、撮影後に「クイックコピー」「クラウド共有」「ドキュメント用ショット」から選べます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키 하나로 캡처 후 빠른 복사, 클라우드 공유, 문서용 캡처 중에서 고릅니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно сочетание клавиш, а после захвата — выбор: «Быстрое копирование», «Поделиться через облако» или «Снимок для документации»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phím tắt, sau khi chụp thì chọn Chụp nhanh để copy, Chia sẻ qua Cloud hoặc Ảnh cho tài liệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个快捷键，截取后再选择“快速复制”“云端分享”或“文档截图”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一個快速鍵，擷取後再選擇「快速拷貝」「雲端分享」或「文件截圖」。"
          }
        }
      }
    },
    "automations.gallery.title": {
