      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "URL-Schema, Befehlszeile und Kurzbefehle erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow URL scheme, command line and Shortcuts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir esquema de URL, línea de comandos y Atajos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le schéma d’URL, la ligne de commande et Raccourcis"
          }
