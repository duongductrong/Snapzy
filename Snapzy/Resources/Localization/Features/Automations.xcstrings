    "automations.show-in.description": {
      "comment": "Automation editor footer for the Show In section of a capturing automation",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Quick Access und dem Verlauf wird sie auf die Datei des Eintrags angewendet, statt aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From Quick Access and History, it runs on that item’s file instead of capturing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desde Acceso rápido y el Historial, se ejecuta en el archivo de ese elemento en lugar de capturar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis Accès rapide et l’Historique, elle s’exécute sur le fichier de l’élément au lieu de capturer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגישה מהירה ומההיסטוריה היא פועלת על הקובץ של הפריט במקום לצלם."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クイックアクセスや履歴からは、キャプチャせずにその項目のファイルに対して実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠른 접근과 기록에서는 캡처하지 않고 해당 항목의 파일에서 실행됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из быстрого доступа и истории она запускается для файла элемента, без нового снимка."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ Truy cập nhanh và Lịch sử, nó chạy trên tệp của mục đó thay vì chụp mới."
          }
        },
        "zh-Hans": {
