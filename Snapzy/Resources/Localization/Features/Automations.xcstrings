    "automations.source.clipboard-description": {
      "comment": "Editor caption for the clipboard image source",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt die Schritte mit dem Bild in der Zwischenablage aus. Es wird zuerst als neue Aufnahme gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs the steps on the image currently on the clipboard. It is saved as a new capture first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta los pasos con la imagen que hay en el portapapeles. Primero se guarda como una nueva captura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute les étapes sur l’image du presse-papiers. Elle est d’abord enregistrée comme nouvelle capture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מריץ את השלבים על התמונה שבלוח. קודם היא נשמרת כצילום חדש."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードにある画像に対してステップを実行します。先に新しいキャプチャとして保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드에 있는 이미지에서 단계를 실행합니다. 먼저 새 캡처로 저장됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполняет шаги для изображения из буфера обмена. Сначала оно сохраняется как новый снимок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy các bước trên ảnh đang có trong bộ nhớ tạm. Ảnh sẽ được lưu thành một ảnh chụp mới trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对剪贴板中的图像运行这些步骤。图像会先保存为新的截图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對剪貼簿中的影像執行這些步驟。影像會先儲存為新的截圖。"
          }
        }
      }
    },
