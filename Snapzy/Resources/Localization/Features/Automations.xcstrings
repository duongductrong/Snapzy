    "automations.secrets.description": {
      "comment": "Secrets section description; {secret:NAME} is syntax",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens für Webhooks und eigene Uploader, im Schlüsselbund gespeichert. Mit {secret:NAME} verwenden; Werte werden nie exportiert oder protokolliert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens for webhooks and custom uploaders, kept in your Keychain. Write {secret:NAME} to use one; values are never exported or logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens para webhooks y cargadores personalizados, guardados en tu llavero. Escribe {secret:NAME} para usar uno; los valores nunca se exportan ni se registran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetons pour webhooks et téléverseurs personnalisés, conservés dans votre trousseau. Écrivez {secret:NAME} pour en utiliser un ; les valeurs ne sont jamais exportées ni journalisées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טוקנים ל-Webhooks ולמעלים מותאמים, שמורים במחזיק המפתחות. כותבים {secret:NAME} כדי להשתמש; הערכים לא מיוצאים ולא נרשמים ביומן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook やカスタムアップローダ用のトークンで、キーチェーンに保存されます。{secret:NAME} と書くと使えます。値が書き出されたりログに残ったりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹훅과 사용자 지정 업로더용 토큰으로, 키체인에 저장됩니다. {secret:NAME}으로 사용하며 값은 내보내거나 기록되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Токены для вебхуков и загрузчиков, хранятся в Связке ключей. Пишите {secret:NAME}; значения никогда не экспортируются и не попадают в журнал."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Token cho webhook và trình tải lên tuỳ chỉnh, lưu trong Keychain. Viết {secret:NAME} để dùng; giá trị không bao giờ bị xuất ra hay ghi log."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于 Webhook 和自定义上传器的令牌，保存在钥匙串中。写 {secret:NAME} 即可使用；值永远不会被导出或记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於 Webhook 和自訂上傳器的權杖，儲存在鑰匙圈中。寫 {secret:NAME} 即可使用；值永遠不會被匯出或記錄。"
          }
        }
      }
    },
